      "justifications": [
        {
          "reviewJustification": {
            "highlightedText": {
              "text": "\"The beef was cooked well and service was excellent.\""
            },
            "review": {
              "name": "places/ChIJF-Xb7dqMGGARrzNdUa_u0DI/reviews/Ci9DQUlRQUNvZENodHljRjlvT2tFeWNHWmpPVGhvUkhVdGVrcElMV0o0VTI4eFRHYxAB",
              "relativePublishTimeDescription": "10 months ago",
              "rating": 5,
              "text": {
                "text": "Satisfying gyudon for such an affordable price in the heart of Tokyo. I came here around lunch time with my brother who can speak Japanese (lucky me 🙂). There were a lot of locals especially salarymen - it reminds me of traditional Japanese restaurants I only see in films.  The beef was cooked well and service was excellent. The owner was very nice so I waved and said goodbye 😅 Wished there was more meat - I just don't know whether I could order and pay for extra meat. I'd love to try their other bowls when I'm back next time.",
                "languageCode": "en"
              },
              "originalText": {
                "text": "Satisfying gyudon for such an affordable price in the heart of Tokyo. I came here around lunch time with my brother who can speak Japanese (lucky me 🙂). There were a lot of locals especially salarymen - it reminds me of traditional Japanese restaurants I only see in films.  The beef was cooked well and service was excellent. The owner was very nice so I waved and said goodbye 😅 Wished there was more meat - I just don't know whether I could order and pay for extra meat. I'd love to try their other bowls when I'm back next time.",
                "languageCode": "en"
              },
              "authorAttribution": {
                "displayName": "Mara",

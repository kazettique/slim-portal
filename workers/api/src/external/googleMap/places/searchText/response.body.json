      "reviews": [
        {
          "name": "places/ChIJF-Xb7dqMGGARrzNdUa_u0DI/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xCdWJ6SkVlVEZ3WkdWVk9WWkpZWEZMWDFFekxWRRAB",
          "relativePublishTimeDescription": "3 months ago",
          "rating": 4,
          "text": {
            "text": "A simple, no frills restaurant that serves affordable katsudon and gyudon! It's a cash only restaurant with limited seats but service is extremely fast and the seats open up fairly quickly, as the patrons typically waste no time finishing their bowl. I ordered the gyudon and asked for a raw egg on top, which didn't cost extra (yay)!\n\nTheir English menu doesn't translate in it's entirety, so I recommend using Google translate if you're curious about the extra add-ons to your meal.",
            "languageCode": "en"
          },
          "originalText": {
            "text": "A simple, no frills restaurant that serves affordable katsudon and gyudon! It's a cash only restaurant with limited seats but service is extremely fast and the seats open up fairly quickly, as the patrons typically waste no time finishing their bowl. I ordered the gyudon and asked for a raw egg on top, which didn't cost extra (yay)!\n\nTheir English menu doesn't translate in it's entirety, so I recommend using Google translate if you're curious about the extra add-ons to your meal.",
            "languageCode": "en"
          },

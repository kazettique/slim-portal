      "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21RNWVEQmpOa2xWYUcxQmFtdE5MWEJwVDJaS1MyYxAB!2m1!1s0x808fba02425dad8f:0x6c296c66619367e0"

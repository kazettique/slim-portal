{
  "name": "slim-portal",
  "private": true,
  "workspaces": [
    "packages/share",
    "apps/web",
    "workers/api"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd workers/api dev",
    "type": "bun run type:web && bun run type:sw && bun run type:worker && bun run type:share",
    "type:web": "bun run --cwd apps/web type",
    "type:sw": "bun run --cwd apps/web type:sw",
    "type:worker": "bun run --cwd workers/api type",
    "type:share": "bun run --cwd packages/share type",
    "build:web": "bun run --cwd apps/web build",
    "deploy:web": "bun run build:web && bunx wrangler pages deploy apps/web/dist --project-name slim-portal",
    "deploy:worker": "bun run --cwd workers/api deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.60.0",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsonc": "3.2.0",
    "eslint-plugin-perfectionist": "5.9.0",
    "happy-dom": "20.9.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript-eslint": "8.60.0",
    "vitest": "4.1.7"
  }
}

{
  "name": "slim-portal-web",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "type": "tsc",
    "type:sw": "tsc -p tsconfig.sw.json --noEmit",
    "build:sw": "bun build src/sw.ts --outfile public/sw.js --target browser --format iife",
    "build": "bun run build:sw && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@slim-portal/share": "workspace:*",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}

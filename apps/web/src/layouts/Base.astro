---
import "../styles/global.css";
import { AppConstant } from "../constant";
import { AppUtil } from "../util";

interface Props {
  title: string;
  description?: string;
}

const { title, description = AppConstant.HOME_PAGE_META.description } = Astro.props;
const canonicalPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var stored = "";
        try { stored = localStorage.getItem("setting:theme") || ""; } catch (_) {}
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = stored === "dark" || (stored !== "light" && prefersDark);
        if (isDark) document.documentElement.setAttribute("data-theme", "dark");
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="theme-color-meta" name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.json" />
    <title>{AppUtil.getPageTitle(title)}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main">
        {
          AppConstant.NAV_LIST.map((navItem) => {
            const isActive =
              navItem.url === "/"
                ? canonicalPath === "/"
                : canonicalPath === navItem.url || canonicalPath.startsWith(navItem.url + "/");
            return (
              <a href={navItem.url} aria-current={isActive ? "page" : undefined}>
                {navItem.title}
              </a>
            );
          })
        }
        <!-- <a href="/" aria-current={canonicalPath === "/" ? "page" : undefined}>Home</a> -->
        <!-- <a href="/news" aria-current={canonicalPath === "/news" ? "page" : undefined}>News</a> -->
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <small>{AppConstant.FOOTER_MESSAGE}</small>
    </footer>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js");
        });
      }
      // Sync theme-color meta to current data-theme
      (function () {
        var isDark = document.documentElement.getAttribute("data-theme") === "dark";
        var meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = isDark ? "#121212" : "#ffffff";
      })();
    </script>
  </body>
</html>

---
import "../style/global.css";
import { AppConstant } from "../constant";
import { AppUtil } from "../util";

interface Props {
  icon?: string;
  title: string;
  description?: string;
}

const { icon, title, description = AppConstant.HOME_PAGE_META.description } = Astro.props;
const canonicalPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var stored = "";
        try { stored = localStorage.getItem("setting:theme") || ""; } catch (_) {}
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = stored === "dark" || (stored !== "light" && prefersDark);
        if (isDark) document.documentElement.setAttribute("data-theme", "dark");
        var menuStyle = "both";
        try { menuStyle = localStorage.getItem("setting:menuStyle") || "both"; } catch (_) {}
        if (menuStyle !== "both") document.documentElement.setAttribute("data-menu", menuStyle);
        var menuPosition = "top";
        try { menuPosition = localStorage.getItem("setting:menuPosition") || "top"; } catch (_) {}
        if (menuPosition !== "top") document.documentElement.setAttribute("data-menu-position", menuPosition);
        var textSize = "medium";
        try { textSize = localStorage.getItem("setting:textSize") || "medium"; } catch (_) {}
        if (textSize !== "medium") document.documentElement.setAttribute("data-text-size", textSize);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta id="theme-color-meta" name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.json" />
    <title>{AppUtil.getPageTitle(icon ? `${icon} ${title}` : title)}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main">
        {
          AppConstant.NAV_LIST.map((navItem) => {
            const isActive =
              navItem.url === "/"
                ? canonicalPath === "/"
                : canonicalPath === navItem.url || canonicalPath.startsWith(navItem.url + "/");
            return (
              <a href={navItem.url} aria-current={isActive ? "page" : undefined}>
                <span class="nav__icon">{navItem.icon}</span>
                <span class="nav__text">{navItem.title}</span>
              </a>
            );
          })
        }
        <!-- <a href="/" aria-current={canonicalPath === "/" ? "page" : undefined}>Home</a> -->
        <!-- <a href="/news" aria-current={canonicalPath === "/news" ? "page" : undefined}>News</a> -->
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <small>{AppConstant.FOOTER_MESSAGE} · v{AppConstant.APP_VERSION}</small>
    </footer>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js");
        });
      }
      // Sync theme-color meta to current data-theme
      (function () {
        var isDark = document.documentElement.getAttribute("data-theme") === "dark";
        var meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = isDark ? "#121212" : "#ffffff";
      })();
      // Keep active nav item visible when the nav overflows horizontally
      document.querySelector('nav a[aria-current="page"]')?.scrollIntoView({ inline: "center", block: "nearest" });
      // Expose header height as CSS var for h1 sticky offset and bottom-nav body padding
      (function () {
        var headerEl = document.querySelector("header");
        function updateHeaderH() {
          if (headerEl) document.documentElement.style.setProperty("--header-h", headerEl.offsetHeight + "px");
        }
        updateHeaderH();
        window.addEventListener("resize", updateHeaderH, { passive: true });
      })();
    </script>
  </body>
</html>

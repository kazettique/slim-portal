---
import "../style/global.css";
import { AppConstant } from "../constant";
import { AppUtil } from "../util";

interface Props {
  description?: string;
  icon?: string;
  title: string;
}

const { description = AppConstant.PAGE_META_HOME.description, icon, title } = Astro.props;
const canonicalPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        let stored = "";
        try {
          stored = localStorage.getItem("setting:theme") || "";
        } catch (_) {}
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = stored === "dark" || (stored !== "light" && prefersDark);
        if (isDark) document.documentElement.setAttribute("data-theme", "dark");
        let menuStyle = "both";
        try {
          menuStyle = localStorage.getItem("setting:menuStyle") || "both";
        } catch (_) {}
        if (menuStyle !== "both") document.documentElement.setAttribute("data-menu", menuStyle);
        let menuPosition = "top";
        try {
          menuPosition = localStorage.getItem("setting:menuPosition") || "top";
        } catch (_) {}
        if (menuPosition !== "top")
          document.documentElement.setAttribute("data-menu-position", menuPosition);
        let textSize = "medium";
        try {
          textSize = localStorage.getItem("setting:textSize") || "medium";
        } catch (_) {}
        if (textSize !== "medium")
          document.documentElement.setAttribute("data-text-size", textSize);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport" />
    <meta content="#ffffff" id="theme-color-meta" name="theme-color" />
    <meta content={description} name="description" />
    <link href="/manifest.json" rel="manifest" />
    <title>{AppUtil.getPageTitle(icon ? `${icon} ${title}` : title)}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main">
        {
          AppConstant.NAV_LIST.map((navItem) => {
            const isActive =
              navItem.url === "/"
                ? canonicalPath === "/"
                : canonicalPath === navItem.url || canonicalPath.startsWith(navItem.url + "/");
            return (
              <a aria-current={isActive ? "page" : undefined} href={navItem.url}>
                <span class="nav__icon">{navItem.icon}</span>
                <span class="nav__text">{navItem.title}</span>
              </a>
            );
          })
        }
        <!-- <a href="/" aria-current={canonicalPath === "/" ? "page" : undefined}>Home</a> -->
        <!-- <a href="/news" aria-current={canonicalPath === "/news" ? "page" : undefined}>News</a> -->
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <small>{AppConstant.APP_DESCRIPTION_FOOTER} · v{AppConstant.APP_VERSION}</small>
    </footer>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js");
        });
      }
      // Sync theme-color meta to current data-theme
      (function () {
        const isDark = document.documentElement.getAttribute("data-theme") === "dark";
        const meta = document.getElementById("theme-color-meta");
        if (meta) meta.content = isDark ? "#121212" : "#ffffff";
      })();
      // Keep active nav item visible when the nav overflows horizontally
      document
        .querySelector('nav a[aria-current="page"]')
        ?.scrollIntoView({ block: "nearest", inline: "center" });
      // Expose header height as CSS var for h1 sticky offset and bottom-nav body padding
      (function () {
        const headerEl = document.querySelector("header");
        function updateHeaderH() {
          if (headerEl)
            document.documentElement.style.setProperty("--header-h", headerEl.offsetHeight + "px");
        }
        updateHeaderH();
        window.addEventListener("resize", updateHeaderH, { passive: true });
      })();
    </script>
  </body>
</html>

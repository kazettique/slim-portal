---
import Base from "../layout/Base.astro";
import { AppConstant } from "../constant";
---

<Base icon={AppConstant.BOOKMARK_PAGE_META.icon} title={AppConstant.BOOKMARK_PAGE_META.title} description={AppConstant.BOOKMARK_PAGE_META.description}>
  <h1>{AppConstant.BOOKMARK_PAGE_META.icon} {AppConstant.BOOKMARK_PAGE_META.title}</h1>
  <p>{AppConstant.BOOKMARK_PAGE_META.description}</p>

  <div id="bookmarks-actions" class="bookmarks-actions" style="display:none">
    <button id="delete-selected-btn" class="refresh-btn refresh-btn--danger" disabled>Delete selected</button>
    <button id="delete-all-btn" class="refresh-btn refresh-btn--danger">Delete all</button>
  </div>

  <p id="bookmarks-status" class="status" aria-live="polite"></p>

  <div id="bookmarks-container"></div>
</Base>

<script>
  import { AppConstant } from "../constant";
  import { BookmarkUtil } from "../util.bookmark";
  import { BookmarkPage } from "../type.bookmark";
  import type { Bookmark, PlaceDetailBookmarkParam, TransitRouteBookmarkParam } from "../type.bookmark";
  import { SettingsUtil } from "../util.settings";
  import { TimeFormat } from "../type.settings";

  const actionsEl = document.getElementById("bookmarks-actions") as HTMLDivElement | null;
  const deleteSelectedBtn = document.getElementById("delete-selected-btn") as HTMLButtonElement | null;
  const deleteAllBtn = document.getElementById("delete-all-btn") as HTMLButtonElement | null;
  const statusEl = document.getElementById("bookmarks-status") as HTMLParagraphElement | null;
  const container = document.getElementById("bookmarks-container") as HTMLDivElement | null;


  function formatTime(iso: string | null): string {
    if (!iso) return "—";
    try {
      const fmt = SettingsUtil.getTimeFormat();
      return new Date(iso).toLocaleTimeString("ja-JP", {
        hour: "2-digit",
        minute: "2-digit",
        hour12: fmt === TimeFormat.TWELVE_HOUR,
      });
    } catch {
      return iso;
    }
  }

  function formatCreatedAt(iso: string): string {
    try {
      const fmt = SettingsUtil.getTimeFormat();
      return new Date(iso).toLocaleString("ja-JP", {
        month: "numeric",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        hour12: fmt === TimeFormat.TWELVE_HOUR,
      });
    } catch {
      return iso;
    }
  }

  function transfersText(transfers: number): string {
    if (transfers === 0) return "No transfers";
    return `${transfers} transfer${transfers > 1 ? "s" : ""}`;
  }

  function renderBookmarkContent(bm: Bookmark): string {
    if (bm.page === BookmarkPage.PLACE_DETAIL) {
      const p = bm.params as PlaceDetailBookmarkParam;
      return `
        <div class="bookmark-item__body">
          <a href="${BookmarkUtil.buildUrl(bm)}" class="bookmark-item__label">${bm.label}</a>
          <div class="bookmark-item__meta">${p.address} · Saved ${formatCreatedAt(bm.createdAt)}</div>
        </div>
      `;
    }
    if (bm.page === BookmarkPage.TRANSIT_ROUTE) {
      const p = bm.params as TransitRouteBookmarkParam;
      return `
        <div class="bookmark-item__body">
          <a href="${BookmarkUtil.buildUrl(bm)}" class="bookmark-item__label">${bm.label}</a>
          <div class="bookmark-item__meta">${p.route.totalTime}min · ${transfersText(p.route.transfers)} · Saved ${formatCreatedAt(bm.createdAt)}</div>
        </div>
      `;
    }
    return `<a href="${BookmarkUtil.buildUrl(bm)}" class="bookmark-item__label">${bm.label}</a>`;
  }

  function getCheckedIds(): string[] {
    if (!container) return [];
    return Array.from(container.querySelectorAll<HTMLInputElement>(".bookmark-checkbox:checked")).map(
      (cb) => cb.value,
    );
  }

  function updateDeleteSelectedState(): void {
    if (!deleteSelectedBtn) return;
    deleteSelectedBtn.disabled = getCheckedIds().length === 0;
  }

  function removeItemFromDom(id: string): void {
    if (!container) return;
    const li = container.querySelector<HTMLLIElement>(`li[data-id="${id}"]`);
    if (!li) return;
    const ul = li.parentElement;              // ul.bookmarks-list
    const group = ul?.parentElement;          // section.bookmarks-group
    const category = group?.parentElement;    // section.bookmarks-category
    li.remove();
    if (ul && ul.children.length === 0) {
      group?.remove();
      if (category && category.querySelectorAll(".bookmarks-group").length === 0) {
        category.remove();
      }
    }
  }

  function showEmptyState(): void {
    if (container) container.innerHTML = "";
    if (actionsEl) actionsEl.style.display = "none";
    if (statusEl) statusEl.textContent = AppConstant.MSG_NO_BOOKMARKS;
  }

  function render(): void {
    if (!container) return;

    const bookmarks = BookmarkUtil.getAll();

    if (bookmarks.length === 0) {
      showEmptyState();
      return;
    }

    if (actionsEl) actionsEl.style.display = "flex";
    if (statusEl) statusEl.textContent = "";

    const grouped = new Map<BookmarkPage, Bookmark[]>();
    for (const page of BookmarkUtil.PAGE_ORDER) grouped.set(page, []);
    for (const bm of bookmarks) {
      grouped.get(bm.page)?.push(bm);
    }

    container.innerHTML = BookmarkUtil.CATEGORIES.map(({ label, pages }) => {
        const groups = pages
          .filter((page) => (grouped.get(page)?.length ?? 0) > 0)
          .map((page) => {
            const items = grouped.get(page) ?? [];
            const rows = items
              .map(
                (bm) => `
              <li class="bookmark-item" data-id="${bm.id}">
                <label class="bookmark-item__check">
                  <input type="checkbox" class="bookmark-checkbox" value="${bm.id}" aria-label="Select ${bm.label}" />
                </label>
                ${renderBookmarkContent(bm)}
                <button class="bookmark-item__delete refresh-btn" data-id="${bm.id}" aria-label="Delete ${bm.label}">Delete</button>
              </li>
            `,
              )
              .join("");
            return `
            <section class="bookmarks-group" data-page="${page}">
              <h3>${BookmarkUtil.BOOKMARK_PAGE_LABELS[page]}</h3>
              <ul class="bookmarks-list">${rows}</ul>
            </section>
          `;
          })
          .join("");
        if (!groups) return "";
        return `
        <section class="bookmarks-category">
          <h2>${label}</h2>
          ${groups}
        </section>
      `;
      })
      .join("");
  }

  // Delegated events on container
  container?.addEventListener("change", (e) => {
    if ((e.target as HTMLElement).classList.contains("bookmark-checkbox")) {
      updateDeleteSelectedState();
    }
  });

  container?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".bookmark-item__delete");
    if (!btn) return;
    const id = btn.dataset["id"];
    if (!id) return;
    if (!confirm(AppConstant.CONFIRM_DELETE_BOOKMARK)) return;
    BookmarkUtil.delete(id);
    removeItemFromDom(id);
    updateDeleteSelectedState();
    if (BookmarkUtil.getAll().length === 0) showEmptyState();
  });

  // Delete selected
  deleteSelectedBtn?.addEventListener("click", () => {
    const ids = getCheckedIds();
    if (ids.length === 0) return;
    if (!confirm(AppConstant.CONFIRM_DELETE_SELECTED_BOOKMARKS(ids.length))) return;
    BookmarkUtil.deleteMany(ids);
    for (const id of ids) removeItemFromDom(id);
    updateDeleteSelectedState();
    if (BookmarkUtil.getAll().length === 0) showEmptyState();
  });

  // Delete all
  deleteAllBtn?.addEventListener("click", () => {
    if (!confirm(AppConstant.CONFIRM_DELETE_ALL_BOOKMARKS)) return;
    BookmarkUtil.deleteAll();
    showEmptyState();
  });

  render();
</script>

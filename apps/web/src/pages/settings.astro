---
import Base from "../layouts/Base.astro";
import { AppConstant } from "../constant";
---

<Base
  title={AppConstant.SETTINGS_PAGE_META.title}
  description={AppConstant.SETTINGS_PAGE_META.description}
>
  <h1>{AppConstant.SETTINGS_PAGE_META.title}</h1>

  <!-- ── Time Format ── -->
  <section class="settings-section">
    <h2>Time Format</h2>
    <p>Applied to opening hours, transit times, and cached-at timestamps.</p>
    <div class="settings-group" role="group">
      <span class="settings-group__legend">Display time as</span>
      <label class="settings-group__option">
        <input type="radio" name="timeFormat" id="tf-24h" value="24h" />
        24-hour &nbsp;<span class="settings-group__example">(09:00 – 18:00)</span>
      </label>
      <label class="settings-group__option">
        <input type="radio" name="timeFormat" id="tf-12h" value="12h" />
        12-hour &nbsp;<span class="settings-group__example">(9:00 AM – 6:00 PM)</span>
      </label>
    </div>
  </section>

  <!-- ── Cache ── -->
  <section class="settings-section">
    <h2>Cache</h2>
    <p>The service worker caches pages and API responses for offline use.</p>
    <div class="settings-group">
      <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
        <button id="clear-cache-btn" class="refresh-btn refresh-btn--danger">Clear all caches</button>
        <span id="cache-msg" class="status" aria-live="polite" style="margin:0; padding:0;"></span>
      </div>
      <p id="cache-cleared-at" class="status" style="margin-block-start:0.25rem"></p>
    </div>
  </section>

  <!-- ── Network Usage ── -->
  <section class="settings-section">
    <h2>Network Usage</h2>
    <p>Cumulative data fetched by each page since last reset. Autocomplete calls are excluded.</p>
    <p id="network-since" class="status" style="margin-block-start:-0.5rem; margin-block-end:0.5rem"></p>

    <div class="settings-chart-toggle" role="group" aria-label="Chart grouping">
      <button id="chart-by-hour" class="settings-chart-btn settings-chart-btn--active">By Hour</button>
      <button id="chart-by-day" class="settings-chart-btn">By Day</button>
    </div>
    <div id="usage-chart" aria-live="polite"></div>
    <div id="usage-legend" class="settings-chart-legend"></div>

    <table class="settings-usage-table" aria-label="Network usage by page">
      <thead>
        <tr>
          <th scope="col">Page</th>
          <th scope="col" style="text-align:right">Usage</th>
        </tr>
      </thead>
      <tbody id="usage-tbody"></tbody>
      <tfoot>
        <tr>
          <th scope="row">Total</th>
          <td id="usage-total" style="text-align:right">—</td>
        </tr>
      </tfoot>
    </table>
    <div class="settings-group" style="margin-block-start:calc(var(--space)*0.75)">
      <button id="reset-usage-btn" class="refresh-btn refresh-btn--danger">Reset usage data</button>
    </div>
  </section>

  <!-- ── Reset All ── -->
  <section class="settings-section">
    <h2>Reset</h2>
    <p>Restore all settings to their default values.</p>
    <div class="settings-group">
      <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
        <button id="reset-all-btn" class="refresh-btn refresh-btn--danger">Reset to defaults</button>
        <span id="reset-msg" class="status" aria-live="polite" style="margin:0; padding:0;"></span>
      </div>
    </div>
  </section>
</Base>

<script>
  import { AppSettings, TimeFormat, NetworkPage, NETWORK_PAGE_LABELS } from "../settings";
  import { AppConstant } from "../constant";
  import { AppUtil } from "../util";

  // ── Chart ─────────────────────────────────────────────────────
  const PAGE_COLORS: Record<NetworkPage, string> = {
    [NetworkPage.NEWS]:           "#0057b7",
    [NetworkPage.PLACES_SEARCH]:  "#2e8b57",
    [NetworkPage.PLACES_NEARBY]:  "#6a5acd",
    [NetworkPage.PLACES_DETAILS]: "#e67e22",
    [NetworkPage.TRANSIT]:        "#c0392b",
    [NetworkPage.SEARCH]:         "#16a085",
  };

  type GroupBy = "hour" | "day";
  let currentGroupBy: GroupBy = "hour";

  function renderChart(groupBy: GroupBy): void {
    const log = AppSettings.getNetworkLog();
    const chartEl = document.getElementById("usage-chart");
    const legendEl = document.getElementById("usage-legend");
    if (!chartEl) return;

    if (log.length === 0) {
      chartEl.innerHTML = `<p class="status" style="margin-block:0.5rem">No data yet. Use a page to start tracking.</p>`;
      if (legendEl) legendEl.innerHTML = "";
      return;
    }

    // Build bucket keys
    const now = new Date();
    const buckets: string[] = [];
    if (groupBy === "hour") {
      for (let i = 23; i >= 0; i--) {
        const d = new Date(now);
        d.setHours(now.getHours() - i, 0, 0, 0);
        buckets.push(d.toISOString().slice(0, 13)); // "2026-05-27T14"
      }
    } else {
      for (let i = 6; i >= 0; i--) {
        const d = new Date(now);
        d.setDate(now.getDate() - i);
        buckets.push(d.toISOString().slice(0, 10)); // "2026-05-27"
      }
    }

    // Aggregate bytes per bucket per page
    const agg: Record<string, Record<string, number>> = {};
    for (const b of buckets) agg[b] = {};
    for (const entry of log) {
      const key = groupBy === "hour" ? entry.ts.slice(0, 13) : entry.ts.slice(0, 10);
      if (agg[key] !== undefined) {
        agg[key][entry.page] = (agg[key][entry.page] ?? 0) + entry.bytes;
      }
    }

    const maxBytes = Math.max(
      1,
      ...buckets.map((b) => Object.values(agg[b]).reduce((s, v) => s + v, 0)),
    );

    // SVG dimensions
    const W = 560, H = 160;
    const PAD = { top: 8, right: 8, bottom: 24, left: 42 };
    const chartW = W - PAD.left - PAD.right;
    const chartH = H - PAD.top - PAD.bottom;
    const gap = 2;
    const barW = Math.max(1, Math.floor(chartW / buckets.length) - gap);
    const pages = Object.values(NetworkPage);

    let svg = `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="Network usage ${groupBy === "hour" ? "by hour (last 24h)" : "by day (last 7 days)"}">`;

    // Y-axis gridlines + labels
    for (let step = 0; step <= 4; step++) {
      const y = PAD.top + (chartH / 4) * step;
      const val = (maxBytes * (4 - step)) / 4;
      svg += `<line x1="${PAD.left}" y1="${y.toFixed(1)}" x2="${W - PAD.right}" y2="${y.toFixed(1)}" stroke="var(--border)" stroke-width="1"/>`;
      svg += `<text x="${PAD.left - 4}" y="${(y + 4).toFixed(1)}" text-anchor="end" font-size="9" fill="var(--muted)">${formatKb(val)}</text>`;
    }

    // Stacked bars + x-axis labels
    for (let bi = 0; bi < buckets.length; bi++) {
      const bucket = buckets[bi];
      const x = PAD.left + bi * (barW + gap);
      let yBase = PAD.top + chartH;

      for (const page of pages) {
        const bytes = agg[bucket]?.[page] ?? 0;
        if (bytes === 0) continue;
        const bh = (bytes / maxBytes) * chartH;
        yBase -= bh;
        svg += `<rect x="${x.toFixed(1)}" y="${yBase.toFixed(1)}" width="${barW}" height="${bh.toFixed(1)}" fill="${PAGE_COLORS[page]}"/>`;
      }

      // X label: every 6h for hourly, every day for daily
      const showLabel = groupBy === "hour" ? bi % 6 === 0 : true;
      if (showLabel) {
        const label = groupBy === "hour" ? bucket.slice(11) + "h" : bucket.slice(5);
        svg += `<text x="${(x + barW / 2).toFixed(1)}" y="${H - 4}" text-anchor="middle" font-size="9" fill="var(--muted)">${label}</text>`;
      }
    }

    svg += `</svg>`;
    chartEl.innerHTML = svg;

    // Legend
    if (legendEl) {
      legendEl.innerHTML = pages
        .map(
          (p) =>
            `<span class="settings-chart-legend__item">` +
            `<span class="settings-chart-legend__swatch" style="background:${PAGE_COLORS[p]}"></span>` +
            `${NETWORK_PAGE_LABELS[p]}` +
            `</span>`,
        )
        .join("");
    }
  }

  const btnHour = document.getElementById("chart-by-hour") as HTMLButtonElement | null;
  const btnDay = document.getElementById("chart-by-day") as HTMLButtonElement | null;

  function setActiveToggle(active: GroupBy): void {
    btnHour?.classList.toggle("settings-chart-btn--active", active === "hour");
    btnDay?.classList.toggle("settings-chart-btn--active", active === "day");
  }

  btnHour?.addEventListener("click", () => {
    currentGroupBy = "hour";
    setActiveToggle("hour");
    renderChart("hour");
  });
  btnDay?.addEventListener("click", () => {
    currentGroupBy = "day";
    setActiveToggle("day");
    renderChart("day");
  });

  renderChart(currentGroupBy);

  // ── Time format ───────────────────────────────────────────────
  const tf24 = document.getElementById("tf-24h") as HTMLInputElement | null;
  const tf12 = document.getElementById("tf-12h") as HTMLInputElement | null;

  function applyTimeFormatToUI(format: TimeFormat): void {
    if (tf24) tf24.checked = format === TimeFormat.TWENTY_FOUR_HOUR;
    if (tf12) tf12.checked = format === TimeFormat.TWELVE_HOUR;
  }

  applyTimeFormatToUI(AppSettings.getTimeFormat());

  document.querySelectorAll<HTMLInputElement>('input[name="timeFormat"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      const value = radio.value === TimeFormat.TWELVE_HOUR
        ? TimeFormat.TWELVE_HOUR
        : TimeFormat.TWENTY_FOUR_HOUR;
      AppSettings.setTimeFormat(value);
    });
  });

  // ── Cache clear ───────────────────────────────────────────────
  const clearBtn = document.getElementById("clear-cache-btn") as HTMLButtonElement | null;
  const cacheMsg = document.getElementById("cache-msg") as HTMLSpanElement | null;
  const cacheClearedAtEl = document.getElementById("cache-cleared-at") as HTMLParagraphElement | null;

  function renderCacheClearedAt(): void {
    const ts = AppSettings.getCacheClearedAt();
    if (cacheClearedAtEl) {
      cacheClearedAtEl.textContent = ts
        ? `Last cleared: ${AppUtil.formatDate(ts, AppSettings.getTimeFormat())}`
        : "";
    }
  }

  renderCacheClearedAt();

  if (clearBtn) {
    clearBtn.addEventListener("click", async () => {
      if (!window.confirm("Clear all caches? Pages will reload from the network on next visit.")) return;

      clearBtn.disabled = true;
      clearBtn.textContent = "Clearing…";
      if (cacheMsg) cacheMsg.textContent = "";

      try {
        const keys = await caches.keys();
        await Promise.all(keys.map((k) => caches.delete(k)));
        AppSettings.setCacheClearedAt();
        renderCacheClearedAt();
        if (cacheMsg) cacheMsg.textContent = AppConstant.MSG_CACHE_CLEARED;
      } catch {
        if (cacheMsg) cacheMsg.textContent = AppConstant.MSG_CACHE_CLEAR_FAILED;
      } finally {
        clearBtn.disabled = false;
        clearBtn.textContent = "Clear all caches";
      }
    });
  }

  // ── Network usage ─────────────────────────────────────────────
  const tbody = document.getElementById("usage-tbody") as HTMLTableSectionElement | null;
  const totalCell = document.getElementById("usage-total") as HTMLTableCellElement | null;
  const resetUsageBtn = document.getElementById("reset-usage-btn") as HTMLButtonElement | null;
  const networkSinceEl = document.getElementById("network-since") as HTMLParagraphElement | null;

  function renderNetworkSince(): void {
    const ts = AppSettings.getNetworkSince();
    if (networkSinceEl) {
      networkSinceEl.textContent = ts
        ? `Since ${AppUtil.formatDate(ts, AppSettings.getTimeFormat())}`
        : "";
    }
  }

  renderNetworkSince();

  function formatKb(bytes: number): string {
    if (bytes === 0) return "0 KB";
    const kb = bytes / 1024;
    return kb < 1000 ? `${kb.toFixed(1)} KB` : `${(kb / 1024).toFixed(2)} MB`;
  }

  function renderUsage(): void {
    const usage = AppSettings.getNetworkUsage();
    let totalBytes = 0;

    if (tbody) {
      tbody.innerHTML = Object.values(NetworkPage)
        .map((page) => {
          const bytes = usage[page] ?? 0;
          totalBytes += bytes;
          const label = page === NetworkPage.NEWS
            ? `${NETWORK_PAGE_LABELS[page]} <span style="font-size:0.75em;color:var(--muted)">(refresh only)</span>`
            : NETWORK_PAGE_LABELS[page];
          return `<tr>
            <td>${label}</td>
            <td style="text-align:right">${formatKb(bytes)}</td>
          </tr>`;
        })
        .join("");
    }

    if (totalCell) totalCell.textContent = formatKb(totalBytes);
  }

  renderUsage();

  if (resetUsageBtn) {
    resetUsageBtn.addEventListener("click", () => {
      AppSettings.resetNetworkUsage();
      renderUsage();
      renderNetworkSince();
      renderChart(currentGroupBy);
    });
  }

  // ── Reset all settings ────────────────────────────────────────
  const resetAllBtn = document.getElementById("reset-all-btn") as HTMLButtonElement | null;
  const resetMsg = document.getElementById("reset-msg") as HTMLSpanElement | null;

  if (resetAllBtn) {
    resetAllBtn.addEventListener("click", () => {
      if (!window.confirm("Reset all settings to defaults? This cannot be undone.")) return;
      AppSettings.resetAll();
      applyTimeFormatToUI(AppSettings.getTimeFormat());
      renderUsage();
      renderNetworkSince();
      renderCacheClearedAt();
      renderChart(currentGroupBy);
      if (resetMsg) resetMsg.textContent = AppConstant.MSG_SETTINGS_RESET;
      setTimeout(() => {
        if (resetMsg) resetMsg.textContent = "";
      }, 3000);
    });
  }
</script>

---
import Base from "../layout/Base.astro";
import { AppConstant } from "../constant";
---

<Base
  icon={AppConstant.PLACE_PAGE_META.icon}
  title={AppConstant.PLACE_PAGE_META.title}
  description={AppConstant.PLACE_PAGE_META.description}
>
  <h1>{AppConstant.PLACE_PAGE_META.icon} {AppConstant.PLACE_PAGE_META.title}</h1>
  <p>{AppConstant.PLACE_PAGE_META.description}</p>

  <form id="places-form" class="places-form">
    <div class="places-form__row">
      <div class="places-form__autocomplete-wrap">
        <input
          id="query-input"
          type="search"
          name="q"
          placeholder="e.g. ramen, coffee, pharmacy"
          autocomplete="on"
          required
          class="places-form__input"
          inputmode="search"
        />
        <ul id="places-suggestion-list" class="places-autocomplete" style="display:none"></ul>
      </div>
      <button type="submit" id="search-btn" class="places-form__submit">Search</button>
    </div>
    <button type="button" id="locate-btn" class="locate-btn">Use my location</button>
  </form>

  <a href="/place/nearby" class="places-nearby-link">Find places nearby →</a>

  <p id="places-status" class="status" aria-live="polite"></p>

  <div id="places-toolbar" class="places-toolbar toolbar" style="display:none">
    <button id="refresh-btn" class="refresh-btn" aria-label="Refresh results">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M1 4v6h6M23 20v-6h-6"></path>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
      Refresh
    </button>
    <button id="bookmark-btn" class="bookmark-btn" aria-label="Save as bookmark">Save</button>
    <span id="cache-status" class="cache-status" aria-live="polite"></span>
  </div>

  <ul id="places-list" class="places-list"></ul>
</Base>

<script>
  import { AppConstant } from "../constant";
  import { AppUtil } from "../util";
  import { SettingsUtil } from "../util.settings";
  import { NetworkPage } from "../type.settings";
  import { BookmarkUtil } from "../util.bookmark";
  import { BookmarkPage } from "../type.bookmark";
  import type { PlaceItem, PlacePrediction } from "@slim-portal/share";
  import type { Bookmark, PlaceBookmarkParam } from "../type.bookmark";

  const form = document.getElementById("places-form") as HTMLFormElement | null;
  const input = document.getElementById("query-input") as HTMLInputElement | null;
  const suggestionList = document.getElementById("places-suggestion-list") as HTMLUListElement | null;
  const locateBtn = document.getElementById("locate-btn") as HTMLButtonElement | null;
  const searchBtn = document.getElementById("search-btn") as HTMLButtonElement | null;
  const list = document.getElementById("places-list") as HTMLUListElement | null;
  const status = document.getElementById("places-status") as HTMLParagraphElement | null;
  const toolbar = document.getElementById("places-toolbar") as HTMLDivElement | null;
  const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement | null;
  const bookmarkBtn = document.getElementById("bookmark-btn") as HTMLButtonElement | null;
  const cacheStatus = document.getElementById("cache-status") as HTMLSpanElement | null;

  let userLat: number | null = null;
  let userLng: number | null = null;
  let lastParams: URLSearchParams | null = null;
  let autocompleteTimer: ReturnType<typeof setTimeout> | null = null;

  function setStatus(msg: string): void {
    if (status) status.textContent = msg;
  }

  function clearSuggestion(): void {
    if (suggestionList) {
      suggestionList.innerHTML = "";
      suggestionList.style.display = "none";
    }
  }

  function renderPlace(items: PlaceItem[]): void {
    if (!list) return;
    if (items.length === 0) {
      list.innerHTML = "";
      setStatus("No places found.");
      return;
    }
    setStatus("");
    list.innerHTML = items
      .map((p) => {
        const detailsLink = p.id ? `<a href="/place/detail?id=${encodeURIComponent(p.id)}">Details</a>` : "";
        const appleMapsLink =
          p.lat !== null && p.lng !== null
            ? `<a href="https://maps.apple.com/?ll=${p.lat},${p.lng}&q=${encodeURIComponent(p.name)}" target="_blank" rel="noopener noreferrer">Apple Maps</a>`
            : "";
        return `
          <li class="place-item">
            <div class="place-item__name">
              <a href="${p.mapsUrl}" target="_blank" rel="noopener noreferrer">${p.name}</a>
              <span class="place-item__distance">${AppUtil.formatDistance(p.distanceMeters)}</span>
            </div>
            <div class="place-item__address">${p.address}</div>
            <div class="place-item__meta">${AppUtil.formatRating(p.rating, p.totalRatings)}</div>
            ${detailsLink || appleMapsLink ? `<div class="place-item__actions">${detailsLink}${appleMapsLink}</div>` : ""}
          </li>
        `;
      })
      .join("");
  }

  async function fetchAutocomplete(word: string): Promise<void> {
    if (!suggestionList) return;
    if (word.length < 1) {
      clearSuggestion();
      return;
    }
    try {
      const params = new URLSearchParams({ input: word });
      if (userLat !== null && userLng !== null) {
        params.set("lat", String(userLat));
        params.set("lng", String(userLng));
      }
      const res = await fetch(`${AppConstant.API_BASE_URL}/place/autocomplete?${params}`, {
        signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT),
      });
      if (!res.ok) return;
      const items = (await res.json()) as PlacePrediction[];
      if (items.length === 0) {
        clearSuggestion();
        return;
      }
      suggestionList.innerHTML = items
        .slice(0, 6)
        .map((item) => {
          const sub = item.secondaryText || "";
          return `
            <li
              class="places-autocomplete__item"
              data-text="${item.mainText || item.text}"
              tabindex="0"
            >
              ${item.mainText || item.text}
              ${sub ? `<div class="places-autocomplete__sub">${sub}</div>` : ""}
            </li>
          `;
        })
        .join("");
      suggestionList.style.display = "block";

      suggestionList.querySelectorAll<HTMLLIElement>(".places-autocomplete__item").forEach((li) => {
        const selectItem = (): void => {
          const text = li.dataset["text"] ?? "";
          if (input) input.value = text;
          clearSuggestion();
        };
        li.addEventListener("click", selectItem);
        li.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") selectItem();
        });
      });
    } catch {
      // silently ignore autocomplete errors
    }
  }

  async function doSearch(params: URLSearchParams, bypassCache: boolean): Promise<void> {
    setStatus("Searching…");
    if (list) list.innerHTML = "";
    if (cacheStatus) cacheStatus.textContent = "";

    try {
      const res = await fetch(`${AppConstant.API_BASE_URL}/place/search?${params}`, {
        cache: bypassCache ? "no-store" : "default",
        signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      SettingsUtil.addNetworkBytes(NetworkPage.PLACE_SEARCH, new Blob([text]).size);
      const items = JSON.parse(text) as PlaceItem[];
      renderPlace(items);

      if (items.length > 0) {
        lastParams = params;
        if (toolbar) toolbar.style.display = "flex";
        const cacheDate = res.headers.get("X-Cache-Date");
        if (cacheStatus)
          cacheStatus.textContent = cacheDate ? AppUtil.formatCacheTime(cacheDate, SettingsUtil.getTimeFormat()) : "";
      }
    } catch {
      setStatus(AppConstant.ERROR_MSG_LOAD_PLACE);
    }
  }

  // Autocomplete wiring
  if (input && suggestionList) {
    input.addEventListener("input", () => {
      if (autocompleteTimer) clearTimeout(autocompleteTimer);
      autocompleteTimer = setTimeout(() => {
        fetchAutocomplete(input.value.trim());
      }, 300);
    });

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target as Node) && !suggestionList.contains(e.target as Node)) {
        clearSuggestion();
      }
    });
  }

  // Geolocation
  if (locateBtn) {
    if (!navigator.geolocation) {
      locateBtn.style.display = "none";
    } else {
      locateBtn.addEventListener("click", () => {
        locateBtn.disabled = true;
        locateBtn.textContent = "Locating…";
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            userLat = pos.coords.latitude;
            userLng = pos.coords.longitude;
            locateBtn.textContent = "Location set ✓";
          },
          () => {
            locateBtn.disabled = false;
            locateBtn.textContent = "Use my location";
            setStatus("Could not get location. Search will work without it.");
          },
          { timeout: AppConstant.REQUEST_TIMEOUT },
        );
      });
    }
  }

  // Form submit
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearSuggestion();
      const q = input?.value.trim() ?? "";
      if (!q) return;

      if (searchBtn) searchBtn.disabled = true;
      const params = new URLSearchParams({ q });
      if (userLat !== null && userLng !== null) {
        params.set("lat", String(userLat));
        params.set("lng", String(userLng));
      }
      history.pushState(null, "", `?${params.toString()}`);
      await doSearch(params, false);
      if (searchBtn) searchBtn.disabled = false;
    });
  }

  // Bookmark
  function saveBookmark(): void {
    const q = input?.value.trim() ?? "";
    if (!q) return;
    const id = Date.now().toString(36) + Math.random().toString(36).slice(2);
    const params: PlaceBookmarkParam = { q };
    const bookmark: Bookmark = {
      id,
      page: BookmarkPage.PLACE,
      label: q,
      params,
      createdAt: new Date().toISOString(),
    };
    BookmarkUtil.add(bookmark);
    if (bookmarkBtn) {
      bookmarkBtn.textContent = AppConstant.MSG_BOOKMARK_SAVED;
      setTimeout(() => {
        if (bookmarkBtn) bookmarkBtn.innerHTML = `${AppConstant.BOOKMARK_ICON} Save`;
      }, 1500);
    }
  }

  bookmarkBtn?.addEventListener("click", saveBookmark);

  // Refresh
  if (refreshBtn) {
    refreshBtn.addEventListener("click", async () => {
      if (!lastParams) return;
      refreshBtn.disabled = true;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Loading…`;
      await doSearch(lastParams, true);
      refreshBtn.disabled = false;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Refresh`;
    });
  }

  window.addEventListener("popstate", () => {
    const urlP = new URLSearchParams(window.location.search);
    const q = urlP.get("q") ?? "";
    const lat = urlP.get("lat");
    const lng = urlP.get("lng");
    const isRestore = urlP.get("restore") === "1";
    if (input) input.value = q;
    if (lat && lng) {
      userLat = parseFloat(lat);
      userLng = parseFloat(lng);
      if (locateBtn) {
        locateBtn.textContent = "Location set ✓";
        locateBtn.disabled = true;
      }
    } else {
      userLat = null;
      userLng = null;
      if (locateBtn) {
        locateBtn.textContent = "Use my location";
        locateBtn.disabled = false;
      }
    }
    if (q && !isRestore) {
      const params = new URLSearchParams({ q });
      if (userLat !== null && userLng !== null) {
        params.set("lat", String(userLat));
        params.set("lng", String(userLng));
      }
      doSearch(params, false);
    } else if (!q) {
      if (list) list.innerHTML = "";
      if (toolbar) toolbar.style.display = "none";
      setStatus("");
    }
  });

  // On load: restore from URL
  const initialParams = new URLSearchParams(window.location.search);
  const initialQ = initialParams.get("q");
  const initialLat = initialParams.get("lat");
  const initialLng = initialParams.get("lng");
  const isInitialRestore = initialParams.get("restore") === "1";
  if (initialLat && initialLng) {
    userLat = parseFloat(initialLat);
    userLng = parseFloat(initialLng);
    if (locateBtn) {
      locateBtn.textContent = "Location set ✓";
      locateBtn.disabled = true;
    }
  }
  if (initialQ && input) {
    input.value = initialQ;
    if (!isInitialRestore) {
      const params = new URLSearchParams({ q: initialQ });
      if (userLat !== null && userLng !== null) {
        params.set("lat", String(userLat));
        params.set("lng", String(userLng));
      }
      doSearch(params, false);
    }
  }
</script>

---
import Base from "../layouts/Base.astro";
import type { NewsItem } from "@slim-portal/share";
import { AppConstant } from "../constant";
import { AppUtil } from "../util";

// const WORKER_URL = import.meta.env.WORKER_URL ?? "";
const apiUrl = AppConstant.WORKER_URL
  ? AppConstant.WORKER_URL + AppConstant.API_BASE_URL + AppConstant.NEWS_PAGE_META.url
  : "http://localhost:8787" + AppConstant.API_BASE_URL + AppConstant.NEWS_PAGE_META.url;

let items: NewsItem[] = [];
let error = "";

try {
  const res = await fetch(apiUrl, { signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT) });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  items = await res.json();
} catch (e) {
  error = AppConstant.ERROR_MSG_LOAD_NEWS;
}
---

<Base title={AppConstant.NEWS_PAGE_META.title} description={AppConstant.NEWS_PAGE_META.description}>
  <h1>{AppConstant.NEWS_PAGE_META.title}</h1>

  {error && <p class="status">{error}</p>}
  {!error && items.length === 0 && <p class="status">No articles found.</p>}

  <div class="news-toolbar toolbar" id="news-toolbar">
    <button id="refresh-btn" class="refresh-btn" aria-label="Refresh news">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M1 4v6h6M23 20v-6h-6"></path>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
      Refresh
    </button>
    <span id="cache-status" class="cache-status" aria-live="polite"></span>
  </div>

  {
    items.length > 0 && (
      <ul class="news-list" id="news-list">
        {items.map((item) => (
          <li class="news-item">
            <div class="news-item__title">
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
              <span class="badge">{item.source}</span>
            </div>
            <div class="news-item__meta">{AppUtil.formatDate(item.publishedAt)}</div>
            {item.summary && <div class="news-item__summary">{item.summary}</div>}
          </li>
        ))}
      </ul>
    )
  }
</Base>

<script>
  import { AppConstant } from "../constant";
  import { AppUtil } from "../util";

  const btn = document.getElementById("refresh-btn") as HTMLButtonElement | null;
  const cacheStatus = document.getElementById("cache-status") as HTMLSpanElement | null;
  const list = document.getElementById("news-list");

  if (btn) {
    btn.addEventListener("click", async () => {
      btn.disabled = true;
      btn.innerHTML = `${AppConstant.REFRESH_ICON} Loading…`;
      if (cacheStatus) cacheStatus.textContent = "";

      try {
        const res = await fetch(AppConstant.API_BASE_URL + AppConstant.NEWS_PAGE_META.url, {
          cache: "no-store",
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const fresh = (await res.json()) as Array<{
          title: string;
          summary: string;
          url: string;
          publishedAt: string;
          source: string;
        }>;

        if (list) {
          list.innerHTML = fresh
            .map(
              (item) => `
            <li class="news-item">
              <div class="news-item__title">
                <a href="${item.url}" target="_blank" rel="noopener noreferrer">${item.title}</a>
                <span class="badge">${item.source}</span>
              </div>
              <div class="news-item__meta">${new Date(item.publishedAt).toLocaleString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}</div>
              ${item.summary ? `<div class="news-item__summary">${item.summary}</div>` : ""}
            </li>
          `,
            )
            .join("");
        }

        const cacheDate = res.headers.get("X-Cache-Date");
        if (cacheStatus) cacheStatus.textContent = cacheDate ? AppUtil.formatCacheTime(cacheDate) : "";
      } catch {
        alert(AppConstant.ERROR_MSG_REFRESH_FAILED);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `${AppConstant.REFRESH_ICON} Refresh`;
      }
    });
  }
</script>

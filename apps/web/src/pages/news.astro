---
import Base from "../layout/Base.astro";
import { AppConstant } from "../constant";
---

<Base icon={AppConstant.NEWS_PAGE_META.icon} title={AppConstant.NEWS_PAGE_META.title} description={AppConstant.NEWS_PAGE_META.description}>
  <h1>{AppConstant.NEWS_PAGE_META.icon} {AppConstant.NEWS_PAGE_META.title}</h1>

  <p class="status" id="news-status" aria-live="polite">Loading…</p>

  <div class="news-toolbar toolbar" id="news-toolbar">
    <button id="refresh-btn" class="refresh-btn" aria-label="Refresh news">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M1 4v6h6M23 20v-6h-6"></path>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
      Refresh
    </button>
    <span id="cache-status" class="cache-status" aria-live="polite"></span>
  </div>

  <!-- Always in DOM so client-side fetch can populate it -->
  <ul class="news-list" id="news-list"></ul>

  <noscript><p class="status">JavaScript is required to load news.</p></noscript>
</Base>

<script>
  import type { NewsItem } from "@slim-portal/share";
  import { AppConstant } from "../constant";
  import { AppUtil } from "../util";
  import { SettingsUtil } from "../util.settings";
  import { NetworkPage } from "../type.settings";

  const btn = document.getElementById("refresh-btn") as HTMLButtonElement | null;
  const cacheStatus = document.getElementById("cache-status") as HTMLSpanElement | null;
  const list = document.getElementById("news-list") as HTMLUListElement | null;
  const statusEl = document.getElementById("news-status") as HTMLParagraphElement | null;

  function setStatus(msg: string): void {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.hidden = msg === "";
  }

  function renderItems(items: NewsItem[], fmt: string): void {
    if (!list) return;
    list.innerHTML = items
      .map(
        (item) => `
        <li class="news-item">
          <div class="news-item__title">
            <a href="${item.url}" target="_blank" rel="noopener noreferrer">${item.title}</a>
            <span class="badge">${item.source}</span>
          </div>
          <div class="news-item__meta">${AppUtil.formatDate(item.publishedAt, fmt)}</div>
          ${item.summary ? `<div class="news-item__summary">${item.summary}</div>` : ""}
        </li>`,
      )
      .join("");
  }

  async function fetchNews(noCache: boolean = false): Promise<void> {
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = `${AppConstant.REFRESH_ICON} Loading…`;
    }
    if (cacheStatus) cacheStatus.textContent = "";

    try {
      const res = await fetch(AppConstant.API_BASE_URL + AppConstant.NEWS_PAGE_META.url, {
        cache: noCache ? "no-store" : "default",
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      SettingsUtil.addNetworkBytes(NetworkPage.NEWS, new Blob([text]).size);
      const items = JSON.parse(text) as NewsItem[];
      const fmt = SettingsUtil.getTimeFormat();

      setStatus(items.length === 0 ? "No articles found." : "");
      renderItems(items, fmt);

      const cacheDate = res.headers.get("X-Cache-Date");
      if (cacheStatus) cacheStatus.textContent = cacheDate ? AppUtil.formatCacheTime(cacheDate, fmt) : "";
    } catch {
      setStatus(AppConstant.ERROR_MSG_LOAD_NEWS);
      if (noCache) alert(AppConstant.ERROR_MSG_REFRESH_FAILED);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `${AppConstant.REFRESH_ICON} Refresh`;
      }
    }
  }

  // Load on page open, bypass SW cache on explicit refresh
  fetchNews();
  btn?.addEventListener("click", () => fetchNews(true));
</script>

---
import Base from '../layouts/Base.astro';
import type { NewsItem } from '@slim-portal/share';

const WORKER_URL = import.meta.env.WORKER_URL ?? '';
const apiUrl = WORKER_URL ? `${WORKER_URL}/api/news` : 'http://localhost:8787/api/news';

let items: NewsItem[] = [];
let error = '';

try {
  const res = await fetch(apiUrl, { signal: AbortSignal.timeout(8000) });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  items = await res.json();
} catch (e) {
  error = 'Could not load news. Please try again later.';
}

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleString('en-US', {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return iso;
  }
}
---

<Base title="News" description="Text-based news reader — top headlines from NHK and Reuters.">
  <h1>News</h1>

  {error && <p class="status">{error}</p>}
  {!error && items.length === 0 && <p class="status">No articles found.</p>}

  {items.length > 0 && (
    <ul class="news-list" id="news-list">
      {items.map(item => (
        <li class="news-item">
          <div class="news-item__title">
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              {item.title}
            </a>
            <span class="badge">{item.source}</span>
          </div>
          <div class="news-item__meta">{formatDate(item.publishedAt)}</div>
          {item.summary && (
            <div class="news-item__summary">{item.summary}</div>
          )}
        </li>
      ))}
    </ul>
  )}

  <button id="refresh-btn" class="refresh-btn" style="display:none" aria-label="Refresh news">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M1 4v6h6M23 20v-6h-6"/>
      <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
    </svg>
    Refresh
  </button>
</Base>

<script>
  const btn = document.getElementById('refresh-btn') as HTMLButtonElement | null;
  const list = document.getElementById('news-list');

  if (btn) {
    btn.style.display = 'inline-flex';

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Loading…';

      try {
        const res = await fetch('/api/news');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const fresh = await res.json() as Array<{
          title: string; summary: string; url: string; publishedAt: string; source: string;
        }>;

        if (list) {
          list.innerHTML = fresh.map(item => `
            <li class="news-item">
              <div class="news-item__title">
                <a href="${item.url}" target="_blank" rel="noopener noreferrer">${item.title}</a>
                <span class="badge">${item.source}</span>
              </div>
              <div class="news-item__meta">${new Date(item.publishedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</div>
              ${item.summary ? `<div class="news-item__summary">${item.summary}</div>` : ''}
            </li>
          `).join('');
        }
      } catch {
        alert('Refresh failed. Check your connection.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 4v6h6M23 20v-6h-6"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg> Refresh`;
      }
    });
  }
</script>

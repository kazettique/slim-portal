---
import Base from "../layouts/Base.astro";
import { AppConstant } from "../constant";
---

<Base title={AppConstant.BATHROOMS_PAGE_META.title} description={AppConstant.BATHROOMS_PAGE_META.description}>
  <h1>{AppConstant.BATHROOMS_PAGE_META.title}</h1>
  <p>{AppConstant.BATHROOMS_PAGE_META.description}</p>

  <div class="places-form" style="margin-block-end: var(--space)">
    <div class="places-form__row">
      <label for="radius-select" style="font-size:0.875rem; align-self:center; white-space:nowrap">Radius</label>
      <select id="radius-select" class="places-form__input" style="flex:1; max-width:10rem">
        <option value="500">500 m</option>
        <option value="1000" selected>1 km</option>
        <option value="2000">2 km</option>
        <option value="5000">5 km</option>
      </select>
      <button type="button" id="search-btn" class="places-form__submit">Search</button>
    </div>
  </div>

  <p id="bathrooms-status" class="status" aria-live="polite"></p>

  <div id="bathrooms-toolbar" class="toolbar" style="display:none">
    <button id="refresh-btn" class="refresh-btn" aria-label="Refresh results">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M1 4v6h6M23 20v-6h-6"></path>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
      Refresh
    </button>
    <span id="cache-status" class="cache-status" aria-live="polite"></span>
  </div>

  <ul id="bathrooms-list" class="places-list"></ul>
</Base>

<script>
  import { AppConstant } from "../constant";
  import { AppUtil } from "../util";
  import { SettingsUtil } from "../util.settings";
  import { NetworkPage } from "../type.settings";
  import type { BathroomItem } from "@slim-portal/share";

  const radiusSelect = document.getElementById("radius-select") as HTMLSelectElement | null;
  const list = document.getElementById("bathrooms-list") as HTMLUListElement | null;
  const statusEl = document.getElementById("bathrooms-status") as HTMLParagraphElement | null;
  const toolbar = document.getElementById("bathrooms-toolbar") as HTMLDivElement | null;
  const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement | null;
  const cacheStatus = document.getElementById("cache-status") as HTMLSpanElement | null;
  const searchBtn = document.getElementById("search-btn") as HTMLButtonElement | null;

  let userLat: number | null = null;
  let userLng: number | null = null;

  function setStatus(msg: string): void {
    if (statusEl) statusEl.textContent = msg;
  }


  function renderBathrooms(items: BathroomItem[]): void {
    if (!list) return;
    if (items.length === 0) {
      list.innerHTML = "";
      setStatus("No bathrooms found nearby.");
      return;
    }
    setStatus("");
    list.innerHTML = items
      .map((b) => {
        const appleMapsLink = `<a href="https://maps.apple.com/?ll=${b.lat},${b.lng}&q=${encodeURIComponent(b.name)}" target="_blank" rel="noopener noreferrer">Apple Maps</a>`;
        const tags = [
          b.accessible ? "♿ Accessible" : "",
          b.changingTable ? "🚼 Changing table" : "",
          b.unisex ? "⚥ Unisex" : "",
        ]
          .filter(Boolean)
          .join(" · ");
        return `
          <li class="place-item">
            <div class="place-item__name">
              <span>${b.name}</span>
              <span class="place-item__distance">${AppUtil.formatDistanceKm(b.distanceKm)}</span>
            </div>
            <div class="place-item__address">${b.city}, ${b.state}</div>
            ${tags ? `<div class="place-item__meta">${tags}</div>` : ""}
            <div class="place-item__actions">${appleMapsLink}</div>
          </li>
        `;
      })
      .join("");
  }

  async function doFetch(bypassCache: boolean): Promise<void> {
    if (userLat === null || userLng === null) return;
    const radius = radiusSelect?.value ?? "1000";
    setStatus("Loading…");
    if (list) list.innerHTML = "";
    if (cacheStatus) cacheStatus.textContent = "";
    if (toolbar) toolbar.style.display = "none";

    try {
      const params = new URLSearchParams({
        lat: String(userLat),
        lng: String(userLng),
        radius,
      });
      const res = await fetch(`${AppConstant.API_BASE_URL}/bathrooms/nearby?${params}`, {
        cache: bypassCache ? "no-store" : "default",
        signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      SettingsUtil.addNetworkBytes(NetworkPage.BATHROOMS, new Blob([text]).size);
      const items = JSON.parse(text) as BathroomItem[];
      renderBathrooms(items);

      if (items.length > 0) {
        if (toolbar) toolbar.style.display = "flex";
        const cacheDate = res.headers.get("X-Cache-Date");
        if (cacheStatus)
          cacheStatus.textContent = cacheDate
            ? AppUtil.formatCacheTime(cacheDate, SettingsUtil.getTimeFormat())
            : "";
      }
    } catch {
      setStatus(AppConstant.ERROR_MSG_LOAD_BATHROOMS);
    }
  }

  // Restore saved radius from URL
  const savedRadius = new URLSearchParams(window.location.search).get("radius");
  if (savedRadius && radiusSelect) {
    radiusSelect.value = savedRadius;
  }

  // Acquire location then fetch; resolves once fetch completes.
  async function locateAndFetch(bypassCache: boolean): Promise<void> {
    if (!navigator.geolocation) {
      setStatus("Geolocation is not supported by your browser.");
      return;
    }
    if (userLat === null || userLng === null) {
      setStatus("Getting your location…");
      await new Promise<void>((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            userLat = pos.coords.latitude;
            userLng = pos.coords.longitude;
            resolve();
          },
          () => reject(new Error("location")),
          { timeout: AppConstant.REQUEST_TIMEOUT },
        );
      }).catch(() => {
        setStatus("Could not get your location. Please allow location access and try again.");
      });
    }
    await doFetch(bypassCache);
  }

  // Re-fetch on radius change (only if location already known)
  if (radiusSelect) {
    radiusSelect.addEventListener("change", () => {
      history.replaceState(null, "", `?radius=${radiusSelect.value}`);
    });
  }

  // Search button
  if (searchBtn) {
    searchBtn.addEventListener("click", async () => {
      searchBtn.disabled = true;
      searchBtn.textContent = "Loading…";
      await locateAndFetch(false);
      searchBtn.disabled = false;
      searchBtn.textContent = "Search";
    });
  }

  // Refresh
  if (refreshBtn) {
    refreshBtn.addEventListener("click", async () => {
      refreshBtn.disabled = true;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Loading…`;
      await locateAndFetch(true);
      refreshBtn.disabled = false;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Refresh`;
    });
  }
</script>

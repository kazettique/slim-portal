---
import { AppConstant } from "../constant";
import Base from "../layout/Base.astro";
---

<Base
  description={AppConstant.HOME_PAGE_META.description}
  icon={AppConstant.HOME_PAGE_META.icon}
  title={AppConstant.HOME_PAGE_META.title}
>
  <h1>{AppConstant.APP_TITLE}</h1>
  <p>{AppConstant.APP_DESCRIPTION}</p>
  <ul class="home-list">
    {
      AppConstant.NAV_LIST.map(
        (feature, index) =>
          index !== 0 && (
            <li class="home-list__item">
              <a href={feature.url}>
                {feature.icon} {feature.title}
              </a>
              <span> — </span>
              <span>{feature.description}</span>
            </li>
          ),
      )
    }
  </ul>
</Base>

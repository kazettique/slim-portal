---
import { AppConstant } from "../../constant";
import Base from "../../layout/Base.astro";
import { JapaneseEra } from "../../type.converter";
import { YearConverterUtil } from "../../util.converter";
---

<Base
  description={AppConstant.PAGE_META_YEAR_CONVERTER.description}
  icon={AppConstant.PAGE_META_YEAR_CONVERTER.icon}
  title={AppConstant.PAGE_META_YEAR_CONVERTER.title}
>
  <h1>{AppConstant.PAGE_META_YEAR_CONVERTER.icon} {AppConstant.PAGE_META_YEAR_CONVERTER.title}</h1>
  <p>{AppConstant.PAGE_META_YEAR_CONVERTER.description}</p>
  <a class="converter-back" href={AppConstant.PAGE_META_CONVERTER.url}>← Back to Converters</a>

  <div class="converter-grid">
    <div class="converter-group">
      <label for="year-western">Western (西元)</label>
      <input
        id="year-western"
        inputmode="numeric"
        max="9999"
        min="1868"
        placeholder="e.g. 2024"
        type="number"
      />
    </div>

    <div class="converter-group">
      <label for="year-roc">ROC Calendar (民國)</label>
      <input id="year-roc" inputmode="numeric" min="1" placeholder="e.g. 113" type="number" />
    </div>

    <div class="converter-group">
      <label for="year-era-num">Japanese Era (元号)</label>
      <div class="converter-group__row year__row">
        <select aria-label="Era name" id="year-era">
          {
            YearConverterUtil.ERA_OPTIONS.map((era) => (
              <option selected={era.value === JapaneseEra.Reiwa} value={era.value}>
                {era.label}
              </option>
            ))
          }
        </select>
        <input
          aria-label="Era year"
          id="year-era-num"
          inputmode="numeric"
          min="1"
          placeholder="e.g. 6"
          type="number"
        />
      </div>
    </div>
  </div>

  <p aria-live="polite" class="converter-note" id="year-note"></p>
</Base>

<script>
  import { JapaneseEra } from "../../type.converter";
  import { YearConverterUtil } from "../../util.converter";

  const westernInput = document.getElementById("year-western") as HTMLInputElement | null;
  const rocInput = document.getElementById("year-roc") as HTMLInputElement | null;
  const eraSelect = document.getElementById("year-era") as HTMLSelectElement | null;
  const eraNumInput = document.getElementById("year-era-num") as HTMLInputElement | null;
  const noteEl = document.getElementById("year-note") as HTMLParagraphElement | null;

  let updating = false;

  function fromEra(): void {
    if (updating) return;
    updating = true;

    const eraName = eraSelect?.value ?? "";
    const eraYear = parseInt(eraNumInput?.value ?? "", 10);
    const western = YearConverterUtil.eraToWestern(eraName as JapaneseEra, eraYear);

    if (western !== null) {
      if (westernInput) westernInput.value = String(western);
      const roc = YearConverterUtil.westernToRoc(western);
      if (rocInput) rocInput.value = roc !== null ? String(roc) : "";
      setNote(western);
    } else {
      if (westernInput) westernInput.value = "";
      if (rocInput) rocInput.value = "";
      if (noteEl) noteEl.textContent = "";
    }

    updating = false;
  }

  function fromRoc(roc: number): void {
    if (updating) return;
    updating = true;
    const western = YearConverterUtil.rocToWestern(roc);
    if (westernInput) westernInput.value = String(western);

    const result = YearConverterUtil.westernToEra(western);
    if (eraSelect && eraNumInput) {
      if (result) {
        eraSelect.value = result.era.name;
        eraNumInput.value = String(result.eraYear);
      } else {
        eraNumInput.value = "";
      }
    }

    setNote(western);
    updating = false;
  }

  function fromWestern(western: number): void {
    if (updating) return;
    updating = true;

    // ROC
    if (rocInput) {
      const roc = YearConverterUtil.westernToRoc(western);
      rocInput.value = roc !== null ? String(roc) : "";
    }

    // Japanese era
    const result = YearConverterUtil.westernToEra(western);
    if (eraSelect && eraNumInput) {
      if (result) {
        eraSelect.value = result.era.name;
        eraNumInput.value = String(result.eraYear);
      } else {
        eraNumInput.value = "";
      }
    }

    setNote(western);
    updating = false;
  }

  function setNote(western: number): void {
    if (!noteEl) return;
    const meijiStart = YearConverterUtil.ERAS[JapaneseEra.Meiji].start;
    const notes: string[] = [];

    if (western < meijiStart)
      notes.push(`ℹ Japanese era (元号) not available before ${meijiStart}`);
    if (western < YearConverterUtil.ROC_START)
      notes.push(`ℹ ROC calendar (民國) not available before ${YearConverterUtil.ROC_START}`);

    if (notes.length > 0) {
      noteEl.textContent = notes.join(" · ");
      return;
    }

    const msg = YearConverterUtil.TRANSITION_YEARS[western];
    noteEl.textContent = msg ? `⚠ ${western} = ${msg} (depends on the month)` : "";
  }

  westernInput?.addEventListener("input", () => {
    const v = parseInt(westernInput.value, 10);
    if (!isNaN(v) && v > 0) fromWestern(v);
  });

  rocInput?.addEventListener("input", () => {
    const v = parseInt(rocInput.value, 10);
    if (!isNaN(v) && v >= 1) fromRoc(v);
  });

  eraNumInput?.addEventListener("input", fromEra);
  eraSelect?.addEventListener("change", fromEra);

  // Initialize with current year
  const currentYear = new Date().getFullYear();
  if (westernInput) westernInput.value = String(currentYear);
  fromWestern(currentYear);
</script>

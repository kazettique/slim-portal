---
import { AppConstant } from "../../constant";
import Base from "../../layout/Base.astro";
---

<Base
  description={AppConstant.PAGE_META_CONVERTER.description}
  icon={AppConstant.PAGE_META_CONVERTER.icon}
  title={AppConstant.PAGE_META_CONVERTER.title}
>
  <h1>{AppConstant.PAGE_META_CONVERTER.icon} {AppConstant.PAGE_META_CONVERTER.title}</h1>
  <p>{AppConstant.PAGE_META_CONVERTER.description}</p>

  <ul class="converter-list">
    <li class="converter-list__item">
      <a href={AppConstant.PAGE_META_YEAR_CONVERTER.url}>
        {AppConstant.PAGE_META_YEAR_CONVERTER.title}
      </a>
      <span>&nbsp;—&nbsp;</span>
      <span>{AppConstant.PAGE_META_YEAR_CONVERTER.description}</span>
    </li>
    <li class="converter-list__item">
      <a href={AppConstant.PAGE_META_AREA_CONVERTER.url}>
        {AppConstant.PAGE_META_AREA_CONVERTER.title}
      </a>
      <span>&nbsp;—&nbsp;</span>
      <span>{AppConstant.PAGE_META_AREA_CONVERTER.description}</span>
    </li>
  </ul>
</Base>

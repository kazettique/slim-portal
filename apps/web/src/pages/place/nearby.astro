---
import Base from "../../layout/Base.astro";
import { AppConstant } from "../../constant";
---

<Base title={AppConstant.PLACE_NEARBY_PAGE_META.title} description={AppConstant.PLACE_NEARBY_PAGE_META.description}>
  <p class="place-details__back"><a href="/place">← Back to search</a></p>

  <h1>{AppConstant.PLACE_NEARBY_PAGE_META.title}</h1>
  <p>{AppConstant.PLACE_NEARBY_PAGE_META.description}</p>

  <div class="places-form" style="margin-block-end: var(--space)">
    <div class="places-form__row">
      <label for="radius-select" style="font-size:0.875rem; align-self:center; white-space:nowrap">Radius</label>
      <select id="radius-select" class="places-form__input" style="flex:1; max-width:10rem">
        <option value="500">500 m</option>
        <option value="1000" selected>1 km</option>
        <option value="2000">2 km</option>
        <option value="5000">5 km</option>
      </select>
    </div>
  </div>

  <p id="nearby-status" class="status" aria-live="polite">Getting your location…</p>

  <div id="nearby-toolbar" class="toolbar" style="display:none">
    <button id="refresh-btn" class="refresh-btn" aria-label="Refresh results">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M1 4v6h6M23 20v-6h-6"></path>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
      Refresh
    </button>
    <span id="cache-status" class="cache-status" aria-live="polite"></span>
  </div>

  <ul id="nearby-list" class="places-list"></ul>
</Base>

<script>
  import { AppConstant } from "../../constant";
  import { AppUtil } from "../../util";
  import { SettingsUtil } from "../../util.settings";
  import { NetworkPage } from "../../type.settings";
  import type { PlaceItem } from "@slim-portal/share";

  const radiusSelect = document.getElementById("radius-select") as HTMLSelectElement | null;
  const list = document.getElementById("nearby-list") as HTMLUListElement | null;
  const statusEl = document.getElementById("nearby-status") as HTMLParagraphElement | null;
  const toolbar = document.getElementById("nearby-toolbar") as HTMLDivElement | null;
  const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement | null;
  const cacheStatus = document.getElementById("cache-status") as HTMLSpanElement | null;

  let userLat: number | null = null;
  let userLng: number | null = null;

  function setStatus(msg: string): void {
    if (statusEl) statusEl.textContent = msg;
  }

  function renderPlaces(items: PlaceItem[]): void {
    if (!list) return;
    if (items.length === 0) {
      list.innerHTML = "";
      setStatus("No places found nearby.");
      return;
    }
    setStatus("");
    list.innerHTML = items
      .map((p) => {
        const detailsLink = p.id
          ? `<a href="/place/detail?id=${encodeURIComponent(p.id)}">Details</a>`
          : "";
        const appleMapsLink =
          p.lat !== null && p.lng !== null
            ? `<a href="https://maps.apple.com/?ll=${p.lat},${p.lng}&q=${encodeURIComponent(p.name)}" target="_blank" rel="noopener noreferrer">Apple Maps</a>`
            : "";
        return `
          <li class="place-item">
            <div class="place-item__name">
              <a href="${p.mapsUrl}" target="_blank" rel="noopener noreferrer">${p.name}</a>
              <span class="place-item__distance">${AppUtil.formatDistance(p.distanceMeters)}</span>
            </div>
            <div class="place-item__address">${p.address}</div>
            <div class="place-item__meta">${AppUtil.formatRating(p.rating, p.totalRatings)}</div>
            ${detailsLink || appleMapsLink ? `<div class="place-item__actions">${detailsLink}${appleMapsLink}</div>` : ""}
          </li>
        `;
      })
      .join("");
  }

  async function doFetch(bypassCache: boolean): Promise<void> {
    if (userLat === null || userLng === null) return;
    const radius = radiusSelect?.value ?? "1000";
    setStatus("Loading…");
    if (list) list.innerHTML = "";
    if (cacheStatus) cacheStatus.textContent = "";
    if (toolbar) toolbar.style.display = "none";

    try {
      const params = new URLSearchParams({
        lat: String(userLat),
        lng: String(userLng),
        radius,
      });
      const res = await fetch(`${AppConstant.API_BASE_URL}/place/nearby?${params}`, {
        cache: bypassCache ? "no-store" : "default",
        signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      SettingsUtil.addNetworkBytes(NetworkPage.PLACE_NEARBY, new Blob([text]).size);
      const items = JSON.parse(text) as PlaceItem[];
      renderPlaces(items);

      if (items.length > 0) {
        if (toolbar) toolbar.style.display = "flex";
        const cacheDate = res.headers.get("X-Cache-Date");
        if (cacheStatus) cacheStatus.textContent = cacheDate ? AppUtil.formatCacheTime(cacheDate, SettingsUtil.getTimeFormat()) : "";
      }
    } catch {
      setStatus(AppConstant.ERROR_MSG_LOAD_PLACE_NEARBY);
    }
  }

  // On load: restore saved radius from URL
  const savedRadius = new URLSearchParams(window.location.search).get("radius");
  if (savedRadius && radiusSelect) {
    radiusSelect.value = savedRadius;
  }

  // Auto-request location on load
  if (!navigator.geolocation) {
    setStatus("Geolocation is not supported by your browser.");
  } else {
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        doFetch(false);
      },
      () => {
        setStatus("Could not get your location. Please allow location access and reload.");
      },
      { timeout: AppConstant.REQUEST_TIMEOUT },
    );
  }

  // Re-fetch on radius change
  if (radiusSelect) {
    radiusSelect.addEventListener("change", () => {
      history.replaceState(null, "", `?radius=${radiusSelect.value}`);
      if (userLat !== null && userLng !== null) doFetch(false);
    });
  }

  // Refresh
  if (refreshBtn) {
    refreshBtn.addEventListener("click", async () => {
      refreshBtn.disabled = true;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Loading…`;
      await doFetch(true);
      refreshBtn.disabled = false;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Refresh`;
    });
  }
</script>

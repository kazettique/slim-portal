---
import { AppConstant } from "../../constant";
import Base from "../../layout/Base.astro";
---

<Base
  description={AppConstant.PLACE_DETAIL_PAGE_META.description}
  icon={AppConstant.PLACE_DETAIL_PAGE_META.icon}
  title={AppConstant.PLACE_DETAIL_PAGE_META.title}
>
  <p class="place-details__back"><a href="/place" id="back-link">← Back</a></p>

  <p aria-live="polite" class="status" id="details-status">Loading…</p>

  <div class="toolbar" id="details-toolbar" style="display:none">
    <button aria-label="Refresh" class="refresh-btn" id="refresh-btn">
      <svg
        aria-hidden="true"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
      >
        <path d="M1 4v6h6M23 20v-6h-6"></path>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
      Refresh
    </button>
    <button aria-label="Save as bookmark" class="bookmark-btn" id="bookmark-btn"></button>
    <span aria-live="polite" class="cache-status" id="cache-status"></span>
  </div>

  <div class="place-details" id="place-details"></div>
</Base>

<script>
  import type { PlaceDetails } from "@slim-portal/share";

  import type { Bookmark } from "../../type.bookmark";

  import { AppConstant } from "../../constant";
  import { BookmarkPage } from "../../type.bookmark";
  import { NetworkPage } from "../../type.settings";
  import { AppUtil } from "../../util";
  import { BookmarkUtil } from "../../util.bookmark";
  import { SettingsUtil } from "../../util.settings";

  const statusEl = document.getElementById("details-status") as HTMLParagraphElement | null;
  const toolbar = document.getElementById("details-toolbar") as HTMLDivElement | null;
  const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement | null;
  const bookmarkBtn = document.getElementById("bookmark-btn") as HTMLButtonElement | null;
  const cacheStatus = document.getElementById("cache-status") as HTMLSpanElement | null;
  const container = document.getElementById("place-details") as HTMLDivElement | null;
  const backLink = document.getElementById("back-link") as HTMLAnchorElement | null;

  const placeId = new URL(location.href).searchParams.get("id");
  const snapshotId = new URL(location.href).searchParams.get("snapshot");

  let lastPlace: null | PlaceDetails = null;

  async function doFetch(bypassCache: boolean): Promise<void> {
    if (!placeId) {
      setStatus("No place ID provided.");
      return;
    }
    setStatus("Loading…");
    if (container) container.innerHTML = "";
    if (cacheStatus) cacheStatus.textContent = "";
    if (toolbar) toolbar.style.display = "none";

    try {
      const params = new URLSearchParams({ id: placeId });
      const res = await fetch(`${AppConstant.API_BASE_URL}/place/detail?${params}`, {
        cache: bypassCache ? "no-store" : "default",
        signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      SettingsUtil.addNetworkBytes(NetworkPage.PLACE_DETAIL, new Blob([text]).size);
      const item = JSON.parse(text) as PlaceDetails;
      lastPlace = item;
      setStatus("");
      renderDetails(item);
      if (toolbar) toolbar.style.display = "flex";
      if (bookmarkBtn) {
        bookmarkBtn.innerHTML = `${AppConstant.BOOKMARK_ICON} Save place`;
      }
      const cacheDate = res.headers.get("X-Cache-Date");
      if (cacheStatus)
        cacheStatus.textContent = cacheDate
          ? AppUtil.formatCacheTime(cacheDate, SettingsUtil.getTimeFormat())
          : "";
    } catch {
      setStatus(AppConstant.ERROR_MSG_LOAD_PLACE_DETAIL);
    }
  }

  function loadSnapshot(): void {
    const bookmark = BookmarkUtil.getById(snapshotId!);
    if (!bookmark) {
      setStatus("Snapshot not found.");
      return;
    }
    const place = bookmark.params as PlaceDetails;
    setStatus("");
    renderDetails(place);
    if (toolbar) toolbar.style.display = "flex";
    if (refreshBtn) refreshBtn.style.display = "none";
    if (bookmarkBtn) bookmarkBtn.style.display = "none";
    if (cacheStatus) {
      cacheStatus.textContent = `Saved ${AppUtil.formatDate(bookmark.createdAt, SettingsUtil.getTimeFormat())}`;
    }
  }

  function renderDetails(p: PlaceDetails): void {
    if (!container) return;

    const mapsLinks: string[] = [];
    if (p.mapsUrl)
      mapsLinks.push(
        `<a href="${p.mapsUrl}" target="_blank" rel="noopener noreferrer">Google Maps</a>`,
      );
    if (p.lat !== null && p.lng !== null) {
      mapsLinks.push(
        `<a href="https://maps.apple.com/?ll=${p.lat},${p.lng}&q=${encodeURIComponent(p.name)}" target="_blank" rel="noopener noreferrer">Apple Maps</a>`,
      );
    }

    const sections: string[] = [];

    if (p.address) {
      sections.push(`
      <div class="place-details__section">
        <span class="place-details__label">Address</span>
        <div class="place-details__value">${p.address}</div>
      </div>
    `);
    }

    if (p.rating !== null || p.totalRatings > 0) {
      sections.push(`
      <div class="place-details__section">
        <span class="place-details__label">Rating</span>
        <div class="place-details__value">${AppUtil.formatRating(p.rating, p.totalRatings)}</div>
      </div>
    `);
    }

    if (p.phoneNumber) {
      sections.push(`
      <div class="place-details__section">
        <span class="place-details__label">Phone</span>
        <div class="place-details__value"><a href="tel:${p.phoneNumber}">${p.phoneNumber}</a></div>
      </div>
    `);
    }

    if (p.website) {
      const display = p.website.replace(/^https?:\/\//, "").replace(/\/$/, "");
      sections.push(`
      <div class="place-details__section">
        <span class="place-details__label">Website</span>
        <div class="place-details__value"><a href="${p.website}" target="_blank" rel="noopener noreferrer">${display}</a></div>
      </div>
    `);
    }

    if (p.businessStatus) {
      sections.push(`
      <div class="place-details__section">
        <span class="place-details__label">Status</span>
        <div class="place-details__value">
          <span class="${AppUtil.statusClass(p.businessStatus)}">${p.businessStatus.replace(/_/g, " ")}</span>
        </div>
      </div>
    `);
    }

    if (p.openingHours && p.openingHours.length > 0) {
      const fmt = SettingsUtil.getTimeFormat();
      const hours = p.openingHours
        .map((h) => `<li>${SettingsUtil.convertHoursString(h, fmt)}</li>`)
        .join("");
      sections.push(`
      <div class="place-details__section">
        <span class="place-details__label">Opening Hours</span>
        <ul class="place-details__hours">${hours}</ul>
      </div>
    `);
    }

    container.innerHTML = `
    <div class="place-details__name">${p.name}</div>
    ${mapsLinks.length > 0 ? `<div class="place-details__maps">${mapsLinks.join("")}</div>` : ""}
    ${sections.join("")}
    <div class="place-details__section">
      <a href="/place/nearby">Find nearby places</a>
    </div>
  `;
  }

  function saveBookmark(): void {
    if (!lastPlace) return;
    const id = Date.now().toString(36) + Math.random().toString(36).slice(2);
    const bookmark: Bookmark = {
      createdAt: new Date().toISOString(),
      id,
      label: lastPlace.name,
      page: BookmarkPage.PLACE_DETAIL,
      params: lastPlace,
    };
    BookmarkUtil.add(bookmark);
    if (bookmarkBtn) {
      bookmarkBtn.textContent = AppConstant.MSG_BOOKMARK_SAVED;
      setTimeout(() => {
        if (bookmarkBtn) bookmarkBtn.innerHTML = `${AppConstant.BOOKMARK_ICON} Save place`;
      }, 1500);
    }
  }

  function setStatus(msg: string): void {
    if (statusEl) statusEl.textContent = msg;
  }

  bookmarkBtn?.addEventListener("click", saveBookmark);

  // Use history.back() if referrer is within this site
  if (backLink) {
    backLink.addEventListener("click", (e) => {
      if (document.referrer && new URL(document.referrer).origin === location.origin) {
        e.preventDefault();
        history.back();
      }
    });
  }

  if (snapshotId) {
    loadSnapshot();
  } else if (placeId) {
    doFetch(false);
  } else {
    setStatus("No place ID provided.");
  }

  if (refreshBtn) {
    refreshBtn.addEventListener("click", async () => {
      refreshBtn.disabled = true;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Loading…`;
      await doFetch(true);
      refreshBtn.disabled = false;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Refresh`;
    });
  }
</script>

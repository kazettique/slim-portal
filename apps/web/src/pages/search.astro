---
import Base from "../layout/Base.astro";
import { AppConstant } from "../constant";
---

<Base
  icon={AppConstant.SEARCH_PAGE_META.icon}
  title={AppConstant.SEARCH_PAGE_META.title}
  description={AppConstant.SEARCH_PAGE_META.description}
>
  <h1>{AppConstant.SEARCH_PAGE_META.icon} {AppConstant.SEARCH_PAGE_META.title}</h1>
  <p>{AppConstant.SEARCH_PAGE_META.description}</p>

  <form id="search-form" class="search-form">
    <div class="search-form__row">
      <input
        id="query-input"
        type="search"
        name="q"
        placeholder="e.g. Tokyo, Python, climate change"
        autocomplete="on"
        required
        class="search-form__input"
        inputmode="search"
      />
      <button type="submit" class="search-form__submit">Search</button>
    </div>
  </form>

  <p id="search-status" class="status" aria-live="polite"></p>

  <div id="search-toolbar" class="search-toolbar toolbar" style="display:none">
    <button id="refresh-btn" class="refresh-btn" aria-label="Refresh results">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M1 4v6h6M23 20v-6h-6"></path>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
      Refresh
    </button>
    <button id="bookmark-btn" class="bookmark-btn" aria-label="Save as bookmark">Save</button>
    <span id="cache-status" class="cache-status" aria-live="polite"></span>
  </div>

  <ul id="search-list" class="search-list"></ul>
</Base>

<script>
  import { AppConstant } from "../constant";
  import { AppUtil } from "../util";
  import { SettingsUtil } from "../util.settings";
  import { NetworkPage } from "../type.settings";
  import { BookmarkUtil } from "../util.bookmark";
  import { BookmarkPage } from "../type.bookmark";
  import type { SearchItem } from "@slim-portal/share";
  import type { Bookmark, SearchBookmarkParam } from "../type.bookmark";

  const form = document.getElementById("search-form") as HTMLFormElement | null;
  const input = document.getElementById("query-input") as HTMLInputElement | null;
  const list = document.getElementById("search-list") as HTMLUListElement | null;
  const status = document.getElementById("search-status") as HTMLParagraphElement | null;
  const toolbar = document.getElementById("search-toolbar") as HTMLDivElement | null;
  const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement | null;
  const bookmarkBtn = document.getElementById("bookmark-btn") as HTMLButtonElement | null;
  const cacheStatus = document.getElementById("cache-status") as HTMLSpanElement | null;

  let lastQ: string | null = null;

  function setStatus(msg: string): void {
    if (status) status.textContent = msg;
  }

  function renderResult(items: SearchItem[]): void {
    if (!list) return;
    if (items.length === 0) {
      list.innerHTML = "";
      setStatus("No results found.");
      return;
    }
    setStatus("");
    list.innerHTML = items
      .map(
        (item) => `
      <li class="search-item">
        <div class="search-item__title">
          <a href="${item.url}" target="_blank" rel="noopener noreferrer">${item.title}</a>
        </div>
        ${item.snippet ? `<div class="search-item__snippet">${item.snippet}</div>` : ""}
        <div class="search-item__url">${item.url}</div>
      </li>
    `,
      )
      .join("");
  }

  async function doSearch(q: string, bypassCache: boolean): Promise<void> {
    setStatus("Searching…");
    if (list) list.innerHTML = "";
    if (cacheStatus) cacheStatus.textContent = "";

    try {
      const params = new URLSearchParams({ q });
      const res = await fetch(`${AppConstant.API_BASE_URL}/search?${params}`, {
        cache: bypassCache ? "no-store" : "default",
        signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      SettingsUtil.addNetworkBytes(NetworkPage.SEARCH, new Blob([text]).size);
      const items = JSON.parse(text) as SearchItem[];
      renderResult(items);

      if (items.length > 0) {
        lastQ = q;
        if (toolbar) toolbar.style.display = "flex";
        const cacheDate = res.headers.get("X-Cache-Date");
        if (cacheStatus)
          cacheStatus.textContent = cacheDate ? AppUtil.formatCacheTime(cacheDate, SettingsUtil.getTimeFormat()) : "";
      }
    } catch {
      setStatus(AppConstant.ERROR_MSG_SEARCH_FAILED);
    }
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const q = input?.value.trim() ?? "";
      if (!q) return;
      history.pushState(null, "", `?${new URLSearchParams({ q }).toString()}`);
      await doSearch(q, false);
    });
  }

  // Bookmark
  function saveBookmark(): void {
    if (!lastQ) return;
    const id = Date.now().toString(36) + Math.random().toString(36).slice(2);
    const params: SearchBookmarkParam = { q: lastQ };
    const bookmark: Bookmark = {
      id,
      page: BookmarkPage.SEARCH,
      label: lastQ,
      params,
      createdAt: new Date().toISOString(),
    };
    BookmarkUtil.add(bookmark);
    if (bookmarkBtn) {
      bookmarkBtn.textContent = AppConstant.MSG_BOOKMARK_SAVED;
      setTimeout(() => {
        if (bookmarkBtn) bookmarkBtn.innerHTML = `${AppConstant.BOOKMARK_ICON} Save`;
      }, 1500);
    }
  }

  bookmarkBtn?.addEventListener("click", saveBookmark);

  if (refreshBtn) {
    refreshBtn.addEventListener("click", async () => {
      if (!lastQ) return;
      refreshBtn.disabled = true;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Loading…`;
      await doSearch(lastQ, true);
      refreshBtn.disabled = false;
      refreshBtn.innerHTML = `${AppConstant.REFRESH_ICON} Refresh`;
    });
  }

  window.addEventListener("popstate", () => {
    const urlP = new URLSearchParams(window.location.search);
    const q = urlP.get("q") ?? "";
    const isRestore = urlP.get("restore") === "1";
    if (input) input.value = q;
    if (q && !isRestore) {
      doSearch(q, false);
    } else if (!q) {
      if (list) list.innerHTML = "";
      if (toolbar) toolbar.style.display = "none";
      setStatus("");
    }
  });

  // On load: restore from URL
  const initialParams = new URLSearchParams(window.location.search);
  const initialQ = initialParams.get("q");
  const isInitialRestore = initialParams.get("restore") === "1";
  if (initialQ && input) {
    input.value = initialQ;
    if (!isInitialRestore) doSearch(initialQ, false);
  }
</script>

---
import { AppConstant } from "../constant";
import Base from "../layout/Base.astro";
---

<Base
  description={AppConstant.PAGE_META_TRANSIT.description}
  icon={AppConstant.PAGE_META_TRANSIT.icon}
  title={AppConstant.PAGE_META_TRANSIT.title}
>
  <h1>{AppConstant.PAGE_META_TRANSIT.icon} {AppConstant.PAGE_META_TRANSIT.title}</h1>
  <p>{AppConstant.PAGE_META_TRANSIT.description}</p>

  <form class="transit-form" id="transit-form">
    <div class="transit-form__group">
      <label class="transit-form__label" for="from-input">From</label>
      <div class="transit-form__row">
        <div class="transit-form__autocomplete-wrap">
          <input
            autocomplete="off"
            class="transit-form__input"
            id="from-input"
            placeholder="Station name"
            type="search"
          />
          <ul class="transit-autocomplete" id="from-suggestion-list" style="display:none"></ul>
        </div>
        <button class="locate-btn" id="locate-btn" type="button">Use location</button>
      </div>
    </div>

    <div class="transit-form__group">
      <label class="transit-form__label" for="to-input">To</label>
      <div class="transit-form__row">
        <div class="transit-form__autocomplete-wrap">
          <input
            autocomplete="off"
            class="transit-form__input"
            id="to-input"
            placeholder="Station name"
            type="search"
          />
          <ul class="transit-autocomplete" id="to-suggestion-list" style="display:none"></ul>
        </div>
      </div>
    </div>

    <div class="transit-form__group">
      <label class="transit-form__label" for="datetime-input">Departure</label>
      <input
        class="transit-form__input transit-form__datepicker"
        id="datetime-input"
        type="datetime-local"
      />
    </div>

    <button class="transit-form__submit" id="search-btn" type="submit">Search routes</button>
  </form>

  <p aria-live="polite" class="status" id="transit-status"></p>

  <div class="toolbar" id="transit-toolbar" style="display:none">
    <button aria-label="Refresh results" class="refresh-btn" id="refresh-btn">
      <svg
        aria-hidden="true"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
      >
        <path d="M1 4v6h6M23 20v-6h-6"></path>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
      Refresh
    </button>
    <button aria-label="Save search as bookmark" class="bookmark-btn" id="bookmark-btn"
      >Save search</button
    >
    <span aria-live="polite" class="cache-status" id="cache-status"></span>
  </div>

  <ul class="transit-route-list" id="transit-route-list"></ul>
</Base>

<script>
  import type { TransitLeg, TransitRoute, TransportAutocompleteNode } from "@slim-portal/share";

  import type { Bookmark, TransitBookmarkParam, TransitRouteBookmarkParam } from "../type.bookmark";

  import { AppConstant } from "../constant";
  import { BookmarkPage } from "../type.bookmark";
  import { NetworkPage, TimeFormat } from "../type.settings";
  import { AppUtil } from "../util";
  import { BookmarkUtil } from "../util.bookmark";
  import { SettingsUtil } from "../util.settings";
  import { TransitUtil } from "../util.transit";

  const form = document.getElementById("transit-form") as HTMLFormElement | null;
  const fromInput = document.getElementById("from-input") as HTMLInputElement | null;
  const toInput = document.getElementById("to-input") as HTMLInputElement | null;
  const datetimeInput = document.getElementById("datetime-input") as HTMLInputElement | null;
  const fromSuggestionList = document.getElementById(
    "from-suggestion-list",
  ) as HTMLUListElement | null;
  const toSuggestionList = document.getElementById("to-suggestion-list") as HTMLUListElement | null;
  const locateBtn = document.getElementById("locate-btn") as HTMLButtonElement | null;
  const searchBtn = document.getElementById("search-btn") as HTMLButtonElement | null;
  const routeList = document.getElementById("transit-route-list") as HTMLUListElement | null;
  const statusEl = document.getElementById("transit-status") as HTMLParagraphElement | null;
  const toolbar = document.getElementById("transit-toolbar") as HTMLDivElement | null;
  const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement | null;
  const bookmarkBtn = document.getElementById("bookmark-btn") as HTMLButtonElement | null;
  const cacheStatus = document.getElementById("cache-status") as HTMLSpanElement | null;

  let fromCoord: null | string = null;
  let toCoord: null | string = null;
  let lastFrom: null | string = null;
  let lastTo: null | string = null;
  let fromTimer: null | ReturnType<typeof setTimeout> = null;
  let toTimer: null | ReturnType<typeof setTimeout> = null;
  let lastRoutes: TransitRoute[] = [];

  function clearSuggestion(listEl: HTMLUListElement): void {
    listEl.innerHTML = "";
    listEl.style.display = "none";
  }

  async function doSearch(bypassCache: boolean): Promise<void> {
    if (!fromCoord || !toCoord) {
      setStatus("Please select both a departure and destination station.");
      return;
    }

    // Sync URL — pushState for new searches, replaceState for refresh
    const datetimeValue = datetimeInput?.value ?? "";
    const stateParams = new URLSearchParams({
      datetime: datetimeValue,
      from: fromCoord,
      from_name: fromInput?.value ?? "",
      to: toCoord,
      to_name: toInput?.value ?? "",
    });
    if (bypassCache) {
      history.replaceState(null, "", `?${stateParams.toString()}`);
    } else {
      history.pushState(null, "", `?${stateParams.toString()}`);
    }

    setStatus("Searching…");
    if (routeList) routeList.innerHTML = "";
    if (cacheStatus) cacheStatus.textContent = "";
    if (toolbar) toolbar.style.display = "none";

    try {
      const params = new URLSearchParams({ from: fromCoord, to: toCoord });
      if (datetimeValue) params.set("datetime", `${datetimeValue}:00`);
      const res = await fetch(`${AppConstant.API_BASE_URL}/transit?${params}`, {
        cache: bypassCache ? "no-store" : "default",
        signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      SettingsUtil.addNetworkBytes(NetworkPage.TRANSIT, new Blob([text]).size);
      const routes = JSON.parse(text) as TransitRoute[];
      lastRoutes = routes;
      renderRoute(routes);

      if (routes.length > 0) {
        lastFrom = fromCoord;
        lastTo = toCoord;
        if (toolbar) toolbar.style.display = "flex";
        const cacheDate = res.headers.get("X-Cache-Date");
        if (cacheStatus)
          cacheStatus.textContent = cacheDate
            ? AppUtil.formatCacheTime(cacheDate, SettingsUtil.getTimeFormat())
            : "";
      }
    } catch {
      setStatus(AppConstant.MSG_TRANSIT_SEARCH_FAILED);
    }
  }

  async function fetchAutocomplete(
    word: string,
    listEl: HTMLUListElement,
    inputEl: HTMLInputElement,
    onSelect: (coord: string) => void,
  ): Promise<void> {
    if (word.length < 1) {
      clearSuggestion(listEl);
      return;
    }
    try {
      const params = new URLSearchParams({ word });
      const res = await fetch(`${AppConstant.API_BASE_URL}/transit/autocomplete?${params}`, {
        signal: AbortSignal.timeout(AppConstant.REQUEST_TIMEOUT),
      });
      if (!res.ok) return;
      const items = (await res.json()) as TransportAutocompleteNode[];
      if (items.length === 0) {
        clearSuggestion(listEl);
        return;
      }
      listEl.innerHTML = items
        .slice(0, 6)
        .map((node) => {
          const numbering =
            node.numbering && node.numbering.length > 0
              ? node.numbering.map((n) => `${n.symbol}${n.number}`).join(" ")
              : "";
          const sub = [node.ruby, numbering].filter(Boolean).join(" · ");
          return `
          <li
            class="transit-autocomplete__item"
            data-coord="${node.coord.lat},${node.coord.lng}"
            data-name="${node.name}"
            tabindex="0"
          >
            ${node.name}
            ${sub ? `<div class="transit-autocomplete__sub">${sub}</div>` : ""}
          </li>
        `;
        })
        .join("");
      listEl.style.display = "block";

      listEl.querySelectorAll<HTMLLIElement>(".transit-autocomplete__item").forEach((li) => {
        li.addEventListener("click", () => {
          const coord = li.dataset["coord"] ?? "";
          const name = li.dataset["name"] ?? "";
          inputEl.value = name;
          onSelect(coord);
          clearSuggestion(listEl);
        });
        li.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            const coord = li.dataset["coord"] ?? "";
            const name = li.dataset["name"] ?? "";
            inputEl.value = name;
            onSelect(coord);
            clearSuggestion(listEl);
          }
        });
      });
    } catch {
      // silently ignore autocomplete errors
    }
  }

  function formatTime(iso: null | string): string {
    if (!iso) return "—";
    try {
      const fmt = SettingsUtil.getTimeFormat();
      return new Date(iso).toLocaleTimeString("ja-JP", {
        hour: "2-digit",
        hour12: fmt === TimeFormat.TWELVE_HOUR,
        minute: "2-digit",
      });
    } catch {
      return iso;
    }
  }

  function renderLeg(legs: TransitLeg[]): string {
    return legs
      .map((leg) => {
        const isWalk = TransitUtil.isWalkLeg(leg);
        const cls = isWalk ? "transit-leg transit-leg--walk" : "transit-leg transit-leg--transit";
        const colorStyle = !isWalk && leg.color ? ` style="--leg-color:${leg.color}"` : "";
        const timeRange =
          leg.depart || leg.arrive ? ` · ${formatTime(leg.depart)}–${formatTime(leg.arrive)}` : "";
        const durationText = leg.duration !== null ? ` · ${leg.duration}分` : "";
        const platform = leg.platform ? ` · ${leg.platform}` : "";
        const getoffText = leg.getoff ? ` · 降 ${leg.getoff}号車` : "";
        const distanceText =
          isWalk && leg.distance !== null ? AppUtil.formatDistance(leg.distance) : "";
        return `<li class="${cls}"${colorStyle}>${leg.line} · ${leg.from} → ${leg.to}${timeRange}${durationText}${platform}${getoffText}${distanceText}</li>`;
      })
      .join("");
  }

  function renderRoute(routes: TransitRoute[]): void {
    if (!routeList) return;
    if (routes.length === 0) {
      routeList.innerHTML = "";
      setStatus("No routes found.");
      return;
    }
    setStatus("");
    routeList.innerHTML = routes
      .map((r, i) => {
        const fareText = r.referenceFare
          ? ` · IC ¥${r.referenceFare.ic.toLocaleString()} / 切符 ¥${r.referenceFare.ticket.toLocaleString()}`
          : "";
        return `
      <li class="transit-route">
        <div class="transit-route__summary">
          <span class="transit-route__time">${r.totalTime} min</span>
          <span class="transit-route__meta">
            · ${r.transfers === 0 ? "No transfers" : `${r.transfers} transfer${r.transfers > 1 ? "s" : ""}`}
            · ${formatTime(r.depart)} → ${formatTime(r.arrive)}${fareText}
          </span>
          <button class="transit-route__save bookmark-btn" data-index="${i}" aria-label="Save this route">${AppConstant.ICON_BOOKMARK} Save route</button>
        </div>
        <ul class="transit-route__legs">${renderLeg(r.legs)}</ul>
      </li>
    `;
      })
      .join("");
  }

  function saveRouteBookmark(route: TransitRoute, btnIndex: number): void {
    const fromName = fromInput?.value ?? "";
    const toName = toInput?.value ?? "";
    const id = Date.now().toString(36) + Math.random().toString(36).slice(2);
    const params: TransitRouteBookmarkParam = {
      from: fromCoord ?? "",
      from_name: fromName,
      route,
      to: toCoord ?? "",
      to_name: toName,
    };
    const bookmark: Bookmark = {
      createdAt: new Date().toISOString(),
      id,
      label: `${fromName} → ${toName} (${formatTime(route.depart)})`,
      page: BookmarkPage.TRANSIT_ROUTE,
      params,
    };
    BookmarkUtil.add(bookmark);
    const btn = routeList?.querySelector<HTMLButtonElement>(
      `.transit-route__save[data-index="${btnIndex}"]`,
    );
    if (btn) {
      btn.textContent = AppConstant.MSG_BOOKMARK_SAVED;
      setTimeout(() => {
        if (btn) btn.innerHTML = `${AppConstant.ICON_BOOKMARK} Save route`;
      }, 1500);
    }
  }

  function setStatus(msg: string): void {
    if (statusEl) statusEl.textContent = msg;
  }

  routeList?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".transit-route__save");
    if (!btn) return;
    const index = parseInt(btn.dataset["index"] ?? "-1", 10);
    if (index < 0 || index >= lastRoutes.length) return;
    saveRouteBookmark(lastRoutes[index], index);
  });

  // Geolocation
  if (locateBtn) {
    if (!navigator.geolocation) {
      locateBtn.style.display = "none";
    } else {
      locateBtn.addEventListener("click", () => {
        locateBtn.disabled = true;
        locateBtn.textContent = "Locating…";
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            fromCoord = `${pos.coords.latitude},${pos.coords.longitude}`;
            if (fromInput) fromInput.value = "Current location";
            if (fromSuggestionList) clearSuggestion(fromSuggestionList);
            locateBtn.textContent = "Location set ✓";
          },
          () => {
            locateBtn.disabled = false;
            locateBtn.textContent = "Use location";
            setStatus("Could not get location.");
          },
          { timeout: AppConstant.REQUEST_TIMEOUT },
        );
      });
    }
  }

  // Autocomplete wiring — From
  if (fromInput && fromSuggestionList) {
    fromInput.addEventListener("input", () => {
      if (fromTimer) clearTimeout(fromTimer);
      fromCoord = null; // reset coord when user types
      fromTimer = setTimeout(() => {
        fetchAutocomplete(fromInput.value.trim(), fromSuggestionList, fromInput, (coord) => {
          fromCoord = coord;
        });
      }, 300);
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
      if (!fromInput.contains(e.target as Node) && !fromSuggestionList.contains(e.target as Node)) {
        clearSuggestion(fromSuggestionList);
      }
    });
  }

  // Autocomplete wiring — To
  if (toInput && toSuggestionList) {
    toInput.addEventListener("input", () => {
      if (toTimer) clearTimeout(toTimer);
      toCoord = null; // reset coord when user types
      toTimer = setTimeout(() => {
        fetchAutocomplete(toInput.value.trim(), toSuggestionList, toInput, (coord) => {
          toCoord = coord;
        });
      }, 300);
    });

    document.addEventListener("click", (e) => {
      if (!toInput.contains(e.target as Node) && !toSuggestionList.contains(e.target as Node)) {
        clearSuggestion(toSuggestionList);
      }
    });
  }

  // Form submit
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (searchBtn) searchBtn.disabled = true;
      await doSearch(false);
      if (searchBtn) searchBtn.disabled = false;
    });
  }

  // Bookmark
  function saveBookmark(): void {
    if (!fromCoord || !toCoord) return;
    const fromName = fromInput?.value ?? "";
    const toName = toInput?.value ?? "";
    const id = Date.now().toString(36) + Math.random().toString(36).slice(2);
    const params: TransitBookmarkParam = {
      from: fromCoord,
      from_name: fromName,
      to: toCoord,
      to_name: toName,
    };
    const bookmark: Bookmark = {
      createdAt: new Date().toISOString(),
      id,
      label: `${fromName} → ${toName}`,
      page: BookmarkPage.TRANSIT,
      params,
    };
    BookmarkUtil.add(bookmark);
    if (bookmarkBtn) {
      bookmarkBtn.textContent = AppConstant.MSG_BOOKMARK_SAVED;
      setTimeout(() => {
        if (bookmarkBtn) bookmarkBtn.innerHTML = `${AppConstant.ICON_BOOKMARK} Save search`;
      }, 1500);
    }
  }

  bookmarkBtn?.addEventListener("click", saveBookmark);

  // Refresh
  if (refreshBtn) {
    refreshBtn.addEventListener("click", async () => {
      if (!lastFrom || !lastTo) return;
      fromCoord = lastFrom;
      toCoord = lastTo;
      refreshBtn.disabled = true;
      refreshBtn.innerHTML = `${AppConstant.ICON_REFRESH} Loading…`;
      await doSearch(true);
      refreshBtn.disabled = false;
      refreshBtn.innerHTML = `${AppConstant.ICON_REFRESH} Refresh`;
    });
  }

  window.addEventListener("popstate", () => {
    const urlP = new URLSearchParams(window.location.search);
    const f = urlP.get("from");
    const t = urlP.get("to");
    const fn = urlP.get("from_name");
    const tn = urlP.get("to_name");
    const dt = urlP.get("datetime");
    const isRestore = urlP.get("restore") === "1";
    if (datetimeInput) datetimeInput.value = dt ?? AppUtil.toDatetimeLocalValue(new Date());
    if (f && t && fn && tn) {
      fromCoord = f;
      toCoord = t;
      if (fromInput) fromInput.value = fn;
      if (toInput) toInput.value = tn;
      if (!isRestore) doSearch(false);
    } else {
      fromCoord = null;
      toCoord = null;
      if (fromInput) fromInput.value = "";
      if (toInput) toInput.value = "";
      if (routeList) routeList.innerHTML = "";
      if (toolbar) toolbar.style.display = "none";
      setStatus("");
    }
  });

  // On load: restore from URL or default to now
  const initialParams = new URLSearchParams(window.location.search);
  const initialFrom = initialParams.get("from");
  const initialTo = initialParams.get("to");
  const initialFromName = initialParams.get("from_name");
  const initialToName = initialParams.get("to_name");
  const initialDatetime = initialParams.get("datetime");
  const isInitialRestore = initialParams.get("restore") === "1";
  if (datetimeInput) {
    datetimeInput.value = initialDatetime ?? AppUtil.toDatetimeLocalValue(new Date());
  }
  if (initialFrom && initialTo && initialFromName && initialToName) {
    fromCoord = initialFrom;
    toCoord = initialTo;
    if (fromInput) fromInput.value = initialFromName;
    if (toInput) toInput.value = initialToName;
    if (!isInitialRestore) doSearch(false);
  }
</script>
